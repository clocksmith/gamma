              "budgetDebited": { "type": "boolean" },
              "denominatorDisposition": { "enum": ["included", "excluded_infrastructure", "blocked"] },
              "artifact": { "$ref": "#/$defs/artifactPointer" }
            }
          }
        },
        "checkpointScoreboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "attempted", "evaluated", "failed", "omitted", "selectedCheckpointId", "artifact"],
          "properties": {
            "expected": { "type": "integer", "minimum": 1 },
            "attempted": { "type": "integer", "minimum": 0 },
            "evaluated": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "omitted": { "type": "integer", "minimum": 0 },
            "selectedCheckpointId": { "type": ["string", "null"] },
            "artifact": { "$ref": "#/$defs/artifactPointer" }
          }
        },
        "metricEvidenceIds": { "$ref": "#/$defs/idArray" },
        "contaminationAuditId": { "$ref": "#/$defs/id" },
        "disposition": { "enum": ["accepted", "rejected", "blocked", "invalidated", "promoted"] },
        "reasonCode": { "$ref": "#/$defs/id" },
        "claim": { "$ref": "#/$defs/nonemptyString" },
        "claimBoundary": { "$ref": "#/$defs/nonemptyString" },
        "invalidated": { "type": "boolean" },
        "budgetDebit": { "$ref": "#/$defs/budgetVector" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "selectionId",
        "selectorParticipantId",
        "selectorRevision",
        "selectorPolicyHash",
        "historyHash",
        "registryHash",
        "frozenContractHash",
        "budgetBefore",
        "candidatesConsidered",
        "candidatesRejected",
        "selectedApproachId",
        "selectedInterventionId",
        "causalContractSha256",
        "budgetDebit",
        "budgetRemaining",
        "recursivePath",
        "saturationDecisionId",
        "humanGate",
        "sha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "selectionId": { "$ref": "#/$defs/id" },
        "selectorParticipantId": { "$ref": "#/$defs/id" },
