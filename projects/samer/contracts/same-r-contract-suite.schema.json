        "selectorPolicyHash": { "$ref": "#/$defs/sha256" },
        "historyHash": { "$ref": "#/$defs/sha256" },
        "registryHash": { "$ref": "#/$defs/sha256" },
        "frozenContractHash": { "$ref": "#/$defs/sha256" },
        "budgetBefore": { "$ref": "#/$defs/budgetVector" },
        "candidatesConsidered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["proposalId", "approachId", "interventionId", "participantId", "valid", "rank", "score"],
            "properties": {
              "proposalId": { "$ref": "#/$defs/id" },
              "approachId": { "$ref": "#/$defs/id" },
              "interventionId": { "$ref": "#/$defs/id" },
              "participantId": { "$ref": "#/$defs/id" },
              "valid": { "type": "boolean" },
              "rank": { "type": ["integer", "null"], "minimum": 1 },
              "score": { "type": ["number", "null"] }
            }
          }
        },
        "candidatesRejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["proposalId", "reasonCode", "evidence"],
            "properties": {
              "proposalId": { "$ref": "#/$defs/id" },
              "reasonCode": { "$ref": "#/$defs/id" },
              "evidence": { "$ref": "#/$defs/nonemptyString" }
            }
          }
        },
        "selectedApproachId": { "type": ["string", "null"] },
        "selectedInterventionId": { "type": ["string", "null"] },
        "causalContractSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "budgetDebit": { "$ref": "#/$defs/budgetVector" },
        "budgetRemaining": { "$ref": "#/$defs/budgetVector" },
        "recursivePath": { "$ref": "#/$defs/idArray" },
        "saturationDecisionId": { "$ref": "#/$defs/id" },
        "humanGate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "status", "authority", "overrideReceiptId"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["not_required", "pending", "approved", "rejected", "overridden"] },
            "authority": { "type": ["string", "null"] },
            "overrideReceiptId": { "type": ["string", "null"] }
          }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "saturationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decisionId",
        "saturated",
        "reasonCode",
        "scope",
        "budgetDeclared",
        "budgetSpent",
        "budgetRemaining",
        "eligibleUntriedApproachIds",
        "pendingRequiredTrialIds",
        "blockedTrialIds",
        "terminalTrialIds",
        "ruleEvidence",
        "decisionPolicyHash",
        "sha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "decisionId": { "$ref": "#/$defs/id" },
        "saturated": { "type": "boolean" },
        "reasonCode": {
          "enum": [
            "required_evaluations_pending",
            "eligible_candidates_remain",
            "budget_or_evidence_unresolved",
            "promotion_achieved",
            "candidate_budget_exhausted",
            "eligible_registry_exhausted",
            "predeclared_diminishing_returns_rule_met",
            "domain_owner_stop"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "populationHash", "frozenContractHash", "approachRegistryHash", "historyHash"],
          "properties": {
            "capability": { "$ref": "#/$defs/id" },
            "populationHash": { "$ref": "#/$defs/sha256" },
            "frozenContractHash": { "$ref": "#/$defs/sha256" },
            "approachRegistryHash": { "$ref": "#/$defs/sha256" },
            "historyHash": { "$ref": "#/$defs/sha256" }
          }
        },
        "budgetDeclared": { "$ref": "#/$defs/budgetVector" },
        "budgetSpent": { "$ref": "#/$defs/budgetVector" },
        "budgetRemaining": { "$ref": "#/$defs/budgetVector" },
        "eligibleUntriedApproachIds": { "$ref": "#/$defs/idArray" },
        "pendingRequiredTrialIds": { "$ref": "#/$defs/idArray" },
        "blockedTrialIds": { "$ref": "#/$defs/idArray" },
        "terminalTrialIds": { "$ref": "#/$defs/idArray" },
        "ruleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonemptyString" }
        },
        "decisionPolicyHash": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
