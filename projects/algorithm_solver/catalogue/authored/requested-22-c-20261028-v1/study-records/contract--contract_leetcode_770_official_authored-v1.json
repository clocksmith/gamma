    "value": [
      {
        "id": "R1",
        "text": "Tokenise numbers, variable names, operators and parentheses; multiplication binds tighter than addition and subtraction, which associate left to right."
      },
      {
        "id": "R2",
        "text": "Replace every variable listed in evalvars by its paired value from evalints; leave other variables symbolic."
      },
      {
        "id": "R3",
        "text": "Expand all products and collect like terms; a term is identified by its multiset of variables."
      },
      {
        "id": "R4",
        "text": "Drop terms whose coefficient becomes zero; return an empty list if the whole polynomial is zero."
      },
      {
        "id": "R5",
        "text": "Format each term as the coefficient (always printed, including 1 and negative values) followed by '*name' for each variable in sorted order."
      },
      {
        "id": "R6",
        "text": "Order terms by degree descending, then by the variable sequence in lexicographic order; the constant term goes last."
      },
      {
        "id": "R7",
        "text": "Leave the input string and lists unchanged; return a fresh list."
      }
    ]
  },
