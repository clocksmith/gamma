    "value": [
      {
        "id": "R1",
        "text": "Only whole-row swaps and whole-column swaps are allowed; each swap counts as one move."
      },
      {
        "id": "R2",
        "text": "Return -1 when no sequence of swaps yields a chessboard."
      },
      {
        "id": "R3",
        "text": "Otherwise return the minimum number of swaps; either of the two chessboard colourings is acceptable."
      },
      {
        "id": "R4",
        "text": "Do not modify the input grid."
      }
    ]
  },
