   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "the total equals sum request[i] * (finish round of i)",
   "equal ratios give equal totals in any order"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk17-b-20261028-v1/study-content.json",
