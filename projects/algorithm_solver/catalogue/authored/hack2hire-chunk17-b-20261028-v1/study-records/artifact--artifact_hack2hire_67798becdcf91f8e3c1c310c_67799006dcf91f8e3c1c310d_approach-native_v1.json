  "value": {
   "reference": "bottom-up dynamic programming table over prefixes of s and p",
   "candidate_design": "split p at \"*\" into literal pieces; the first piece must be a prefix of s and the last a suffix (when p has a \"*\"), and each middle piece is placed at its leftmost occurrence after the previous one, which is optimal because \"*\" absorbs any gap",
   "complexity_target": "O(|s| * |p|) worst case with a linear substring search, usually near linear/O(|p|) space"
  },
