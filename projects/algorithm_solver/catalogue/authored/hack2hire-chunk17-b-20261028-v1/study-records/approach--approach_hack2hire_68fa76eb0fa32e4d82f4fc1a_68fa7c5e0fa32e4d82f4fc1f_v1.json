   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "every trie node at depth d corresponds to one pattern prefix of d segments",
   "a candidate match visited earlier in literal-first order wins ties on wildcard count"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk17-b-20261028-v1/study-content.json",
