  "value": {
   "reference": "recursive enumeration of every count vector from the largest denomination down, keeping the best by (total coins, then counts from the largest denomination, larger first)",
   "candidate_design": "suffix tables f_i[a] = fewest coins for amount a using the i-th largest denomination and smaller ones (unbounded knapsack per denomination), then reconstruct from the largest denomination taking the largest count t with f_{i+1}[a - t * c] = f_i[a] - t",
   "complexity_target": "O(len(coins) * target) time and space"
