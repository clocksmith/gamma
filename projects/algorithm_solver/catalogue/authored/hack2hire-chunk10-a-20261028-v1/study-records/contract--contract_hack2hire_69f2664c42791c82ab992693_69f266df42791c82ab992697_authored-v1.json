 "statement": {
  "status": "present",
  "value": "RecipeManager() starts empty. addRecipe(name, ingredients, steps) returns the next id \"recipe<k>\" (k counts successful adds from 1; ids are never reused) or \"\" when another stored recipe has the same name ignoring case. getRecipe(recipeId) returns [name, ingredients, steps] as fresh lists or [] when absent. updateRecipe(recipeId, name, ingredients, steps) replaces all three and returns true, or returns false when the recipe is absent or the new name equals another recipe's name ignoring case. deleteRecipe(recipeId) returns whether a recipe was removed. searchByIngredient(ingredient) returns the ids of recipes with an ingredient equal to it ignoring case, by id number ascending. Every method call is answered in call order on one instance; void methods return nothing.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk10-a-20261028-v1/contracts.json",
    "sha256": "be5d798382a43847401e76609d79932746e664be0d91c81b132bf6b46cd69126",
    "selector": "/problems/26/inferred_spec"
   }
  ]
 },
 "contentScope": "authored",
 "requirements": {
  "status": "present",
  "value": [
   "RecipeManager() starts empty.",
   "addRecipe(name, ingredients, steps) returns the next id \"recipe<k>\" (k counts successful adds from 1; ids are never reused) or \"\" when another stored recipe has the same name ignoring case.",
   "getRecipe(recipeId) returns [name, ingredients, steps] as fresh lists or [] when absent.",
   "updateRecipe(recipeId, name, ingredients, steps) replaces all three and returns true, or returns false when the recipe is absent or the new name equals another recipe's name ignoring case.",
   "deleteRecipe(recipeId) returns whether a recipe was removed.",
   "searchByIngredient(ingredient) returns the ids of recipes with an ingredient equal to it ignoring case, by id number ascending.",
   "Every method call is answered in call order on one instance; void methods return nothing."
  ],
  "provenance": [
   {
