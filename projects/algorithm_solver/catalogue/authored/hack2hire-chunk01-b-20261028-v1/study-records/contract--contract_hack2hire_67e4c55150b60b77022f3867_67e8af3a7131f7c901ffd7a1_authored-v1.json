    "value": [
      {
        "id": "R1",
        "text": "Process orders strictly in input order."
      },
      {
        "id": "R2",
        "text": "A buy matches resting sells with price <= its price, lowest price first; a sell matches resting buys with price >= its price, highest price first."
      },
      {
        "id": "R3",
        "text": "Each trade transfers min(remaining incoming, remaining resting) shares; fully filled resting orders leave the book."
      },
      {
        "id": "R4",
        "text": "Any unfilled remainder of the incoming order rests in the book on its own side."
      },
      {
        "id": "R5",
        "text": "Return the sum of all traded shares as an integer; the input is not modified."
      }
    ]
  },
