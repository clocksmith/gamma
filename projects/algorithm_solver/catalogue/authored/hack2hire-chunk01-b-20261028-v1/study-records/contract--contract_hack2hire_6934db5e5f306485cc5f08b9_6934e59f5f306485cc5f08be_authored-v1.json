    "value": [
      {
        "id": "R1",
        "text": "Build paths exactly as in variant 1: '/' + directory names below the root + file name."
      },
      {
        "id": "R2",
        "text": "Compare files by the concatenation of their chunks; chunk boundaries and empty chunks are irrelevant."
      },
      {
        "id": "R3",
        "text": "Report only groups of two or more identical files, paths sorted, groups sorted by first path."
      },
      {
        "id": "R4",
        "text": "Read content incrementally so that files proven unique are not read to the end."
      },
      {
        "id": "R5",
        "text": "Do not modify the input tree or its chunk lists."
      }
    ]
