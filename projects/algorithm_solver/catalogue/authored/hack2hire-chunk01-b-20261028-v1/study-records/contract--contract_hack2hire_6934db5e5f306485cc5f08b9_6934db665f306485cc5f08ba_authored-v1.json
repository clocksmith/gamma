    "status": "present",
    "value": [
      {
        "id": "R1",
        "text": "Build each file path as '/' + the directory names below the root + the file name, joined by '/'; the root's own name is not part of any path."
      },
      {
        "id": "R2",
        "text": "Two files are duplicates exactly when their byte lists are equal element by element, including two empty files."
      },
      {
        "id": "R3",
        "text": "Report only groups with at least two files; every file appears in at most one group."
      },
      {
        "id": "R4",
        "text": "Sort paths within a group, and sort groups by their first path (plain string order)."
      },
      {
        "id": "R5",
        "text": "Do not modify the input tree; return fresh lists."
      }
    ]
  },
