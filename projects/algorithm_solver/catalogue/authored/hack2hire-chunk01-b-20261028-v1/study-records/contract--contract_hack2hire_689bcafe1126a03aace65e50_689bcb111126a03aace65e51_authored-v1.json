      {
        "id": "R1",
        "text": "Movement is 4-directional and may not enter or start from 'X' cells."
      },
      {
        "id": "R2",
        "text": "The distance to the nearest 'D' is the minimum number of steps over all stores."
      },
      {
        "id": "R3",
        "text": "A 'D' cell answers 0; an 'X' cell or a cell with no reachable store answers -1."
      },
      {
        "id": "R4",
        "text": "Answers are returned in the order of the queries."
      },
      {
        "id": "R5",
        "text": "The map and query list are not modified."
      }
