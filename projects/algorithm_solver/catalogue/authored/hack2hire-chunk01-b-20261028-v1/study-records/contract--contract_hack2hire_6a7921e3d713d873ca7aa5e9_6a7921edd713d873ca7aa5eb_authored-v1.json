      {
        "id": "R1",
        "text": "Split both sentences on single spaces; an empty t has no words."
      },
      {
        "id": "R2",
        "text": "Match t's words to s's words greedily from the left: each t word takes the first equal s word after the previous match."
      },
      {
        "id": "R3",
        "text": "Return the unmatched words of s as a list in their original order."
      },
      {
        "id": "R4",
        "text": "Word comparison is exact and case-sensitive."
      },
      {
        "id": "R5",
        "text": "Do not modify the inputs."
      }
    ]
