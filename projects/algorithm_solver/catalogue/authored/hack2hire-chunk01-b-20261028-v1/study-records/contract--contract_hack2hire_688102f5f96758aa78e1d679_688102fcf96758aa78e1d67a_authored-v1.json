    "status": "present",
    "value": [
      {
        "id": "R1",
        "text": "Serve orders in order of arrival, ties by input index."
      },
      {
        "id": "R2",
        "text": "Assign each order to the earliest-free shopper; it starts at max(arrival, freeTime) and completes after its duration."
      },
      {
        "id": "R3",
        "text": "Wait is completion time minus arrival time; the average is the total wait divided by the number of orders."
      },
      {
        "id": "R4",
        "text": "Return the minimum shopper count with average wait <= maxAverageWait, or -1 if n shoppers are not enough."
      },
      {
        "id": "R5",
        "text": "Do not modify the input."
      }
    ]
  },
