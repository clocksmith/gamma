    "value": [
      {
        "id": "R1",
        "text": "Produce exactly len(chunks) + 1 output strings: one per chunk and one final flush."
      },
      {
        "id": "R2",
        "text": "Never release text at or after the start of a stop word occurrence."
      },
      {
        "id": "R3",
        "text": "Hold back the longest suffix of the pending text that is a proper prefix of some stop word (the one with the smallest start); release everything before it."
      },
      {
        "id": "R4",
        "text": "Once a stop word is confirmed at a position no later than the held-back start, release text before it and output empty strings afterwards."
      },
      {
        "id": "R5",
        "text": "The concatenation of all outputs equals the variant-1 answer on the joined chunks."
      },
      {
        "id": "R6",
        "text": "Do not modify the inputs."
      }
    ]
  },
