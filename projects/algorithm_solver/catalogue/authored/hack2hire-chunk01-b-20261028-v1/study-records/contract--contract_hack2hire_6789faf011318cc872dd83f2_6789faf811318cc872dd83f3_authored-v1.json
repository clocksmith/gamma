    "value": [
      {
        "id": "R1",
        "text": "The distance in a direction is the number of steps to the first X in that direction, or to the position just past the board edge if there is none."
      },
      {
        "id": "R2",
        "text": "Robots and empty cells do not block."
      },
      {
        "id": "R3",
        "text": "Match all four distances in the order left, top, bottom, right."
      },
      {
        "id": "R4",
        "text": "Return matching robot positions as [row, col] in row-major order; an empty list if none."
      },
      {
        "id": "R5",
        "text": "Do not modify the board."
      }
