    "value": [
      {
        "id": "R1",
        "text": "An operation on a file encrypts that file; an operation on a directory encrypts every file in its whole subtree."
      },
      {
        "id": "R2",
        "text": "No operation may encrypt a file whose flag is false."
      },
      {
        "id": "R3",
        "text": "After the operations, every flagged file is encrypted."
      },
      {
        "id": "R4",
        "text": "Return the minimum operation count as an integer; a tree with no flagged files needs 0."
      },
      {
        "id": "R5",
        "text": "The input tree is not modified."
      }
    ]
