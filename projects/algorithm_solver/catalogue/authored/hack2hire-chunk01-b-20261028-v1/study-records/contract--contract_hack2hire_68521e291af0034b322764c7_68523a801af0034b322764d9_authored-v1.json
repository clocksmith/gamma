    "value": [
      {
        "id": "R1",
        "text": "Moves are orthogonal; X cells and cells of other modes are not usable for the chosen mode."
      },
      {
        "id": "R2",
        "text": "Each move out of a mode cell adds that mode's time and cost; the first move out of S is free."
      },
      {
        "id": "R3",
        "text": "Each mode is evaluated independently on its own cells."
      },
      {
        "id": "R4",
        "text": "Choose the reachable mode by smallest total time, then smallest total cost, then lowest index."
      },
      {
        "id": "R5",
        "text": "Return the mode name, or '' if no mode reaches D; inputs are unchanged."
      }
    ]
