    "status": "present",
    "value": [
      {
        "id": "R1",
        "text": "A user who owns the camera directly is an administrator."
      },
      {
        "id": "R2",
        "text": "A user who is a member of a group that owns the camera, directly or through any chain of subgroup memberships, is an administrator."
      },
      {
        "id": "R3",
        "text": "Cycles among groups must not cause infinite loops or duplicates."
      },
      {
        "id": "R4",
        "text": "Return administrators sorted by code-unit order, each once; return an empty list if the camera is unknown."
      },
      {
        "id": "R5",
        "text": "The input triples are not modified."
      }
    ]
