      {
        "id": "R1",
        "text": "Return the messages that are safe, in their original order."
      },
      {
        "id": "R2",
        "text": "A message is unsafe if some token of its text, splitting on spaces and ignoring empty tokens, equals an unsafe word exactly; substrings of longer words do not count."
      },
      {
        "id": "R3",
        "text": "Matching is case-sensitive and exact on characters."
      },
      {
        "id": "R4",
        "text": "Each returned message is a fresh [username, text] pair; inputs are not modified."
      }
