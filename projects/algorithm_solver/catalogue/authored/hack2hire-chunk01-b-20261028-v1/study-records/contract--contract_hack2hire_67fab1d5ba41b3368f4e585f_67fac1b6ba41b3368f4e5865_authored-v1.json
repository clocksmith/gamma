    "value": [
      {
        "id": "R1",
        "text": "Consider every node reachable from start by following edges, including start."
      },
      {
        "id": "R2",
        "text": "Return those reachable nodes that have no outgoing edge, each once."
      },
      {
        "id": "R3",
        "text": "Sort the result in ascending numeric order."
      },
      {
        "id": "R4",
        "text": "Cycles, duplicate edges and self loops must not cause repeated visits or duplicates."
      },
      {
        "id": "R5",
        "text": "The edge list is not modified."
      }
    ]
