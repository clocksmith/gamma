    "value": [
      {
        "id": "R1",
        "text": "An operation targets one file or one directory and sets every file in that scope to encrypted or decrypted."
      },
      {
        "id": "R2",
        "text": "A file's final state is decided by the deepest operation covering it; with no covering operation it stays decrypted."
      },
      {
        "id": "R3",
        "text": "Every file must end in its flagged state."
      },
      {
        "id": "R4",
        "text": "Return the minimum number of operations as an integer."
      },
      {
        "id": "R5",
        "text": "The input tree is not modified."
      }
    ]
  },
