    "selector": "/variants/hack2hire:69e2411e95e80ae213e5d633/variantLabel"
   }
  ]
 },
 "statement": {
  "status": "present",
  "value": "Token id = index in tokenAlphabet. A leading block of single-character tokens covers every character of text; all later tokens have length >= 2 and entries are distinct. Start from the per-character id sequence. Then process each multi-character token j in alphabet order: scan the current sequence left to right and replace every non-overlapping adjacent pair (a, b) whose strings concatenate to token j with the single id j (a merge at position i resumes scanning after the pair). Tokens with no valid split into two earlier tokens therefore never merge. Return the final id sequence.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk03-a-20261028-v1/contracts.json",
