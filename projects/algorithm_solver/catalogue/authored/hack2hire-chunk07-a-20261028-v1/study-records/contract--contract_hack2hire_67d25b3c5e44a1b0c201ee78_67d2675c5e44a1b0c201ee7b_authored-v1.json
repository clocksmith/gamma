 },
 "statement": {
  "status": "present",
  "value": "trades are records [timestamp, symbol, direction, quantity, price] of strings, in time order; direction is \"B\" or \"S\"; quantity and price are positive integers. Cash starts at 1000. A buy subtracts quantity * price from cash and adds the shares; a sell adds q * price to cash and removes q shares, where q is the quantity clamped to the shares currently held (inferred). Every trade sets the latest price of its symbol. Return [[\"CASH\", cash], [symbol, shares], ...] with numbers as decimal strings, holdings with zero shares removed, symbols in ascending order. Levels 2 and 3 add margin calls: whenever cash is negative after a trade, sell one share at a time of the held symbol with the highest latest price (ties: smallest symbol), at that price, until cash >= 0 or nothing is held. Level 3 adds collateral: a symbol made of a stock symbol followed by \"O\" is an option on that stock. During a margin call, a stock share is sellable only while the stock has more shares than its option has; options are always sellable. Shares freed by option sales become sellable at once.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk07-a-20261028-v1/contracts.json",
