   }
  ]
 },
 "chooseWhen": {
  "status": "present",
  "value": [
   "Points are sparse or unbounded, so an array indexed by position is impractical"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk07-a-20261028-v1/study-content.json",
