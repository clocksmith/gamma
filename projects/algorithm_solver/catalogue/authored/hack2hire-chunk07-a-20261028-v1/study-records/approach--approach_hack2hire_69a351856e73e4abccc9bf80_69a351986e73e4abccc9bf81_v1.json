   }
  ]
 },
 "tradeoffs": {
  "status": "present",
  "value": [
   "Union-find also works but needs path compression; endpoint lengths are O(1) per insertion without it"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
