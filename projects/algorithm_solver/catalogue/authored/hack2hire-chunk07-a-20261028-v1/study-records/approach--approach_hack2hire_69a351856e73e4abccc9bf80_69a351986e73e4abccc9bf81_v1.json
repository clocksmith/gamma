 "representation": "coding",
 "explanation": {
  "status": "present",
  "value": "hash map from each run endpoint to its run length; a built house extends the run ending at p - 1 or the run starting at p + 1 (never both, by the build rule). Complexity target: O(n) expected time.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
