   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "for every maximal run [l, r], length[l] = length[r] = r - l + 1",
   "the answer sequence is non-decreasing"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
