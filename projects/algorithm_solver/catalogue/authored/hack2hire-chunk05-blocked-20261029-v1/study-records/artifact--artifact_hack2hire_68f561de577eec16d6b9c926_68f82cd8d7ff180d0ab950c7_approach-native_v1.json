  "value": {
   "reference": "for every left end, extend the right end while keeping a running sum of the strict middle and compare it with both ends",
   "candidate_design": "with prefix sums P, segment l..r is stable when capacity[l] == capacity[r] and P[r] - P[l + 1] == capacity[r]; scan r from left to right, make left end l = r - 2 available by counting the key (capacity[l], P[l + 1]) in a hash map, and add the count of key (capacity[r], P[r] - capacity[r])",
   "complexity_target": "O(n) expected time/O(n) space"
  },
