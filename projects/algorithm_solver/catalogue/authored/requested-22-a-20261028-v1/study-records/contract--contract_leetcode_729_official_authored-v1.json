    "status": "present",
    "value": [
      {
        "id": "R1",
        "text": "Treat each booking as the half-open interval [startTime, endTime); [a, b) and [b, c) do not overlap."
      },
      {
        "id": "R2",
        "text": "Accept a booking and return true only when it overlaps no previously accepted booking."
      },
      {
        "id": "R3",
        "text": "A rejected booking returns false and does not change the calendar."
      },
      {
        "id": "R4",
        "text": "The trace adapter solve(operation_names, argument_lists) creates one MyCalendar, returns null for the constructor and each book result in call order."
      },
      {
        "id": "R5",
        "text": "Do not modify the trace input lists; return a fresh result list."
      }
    ]
  },
