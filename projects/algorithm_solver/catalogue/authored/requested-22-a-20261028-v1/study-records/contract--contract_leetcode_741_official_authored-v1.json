    "value": [
      {
        "id": "R1",
        "text": "Both trips may use only non-thorn cells; the outbound trip moves right or down, the return trip left or up."
      },
      {
        "id": "R2",
        "text": "A cherry counts once even if both trips pass through its cell."
      },
      {
        "id": "R3",
        "text": "Return the maximum total over all valid round trips, or 0 when no corner-to-corner path exists."
      },
      {
        "id": "R4",
        "text": "Do not modify the input grid."
      }
    ]
  },
