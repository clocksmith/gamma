    "value": [
      {
        "id": "R1",
        "text": "Support integer literals (possibly negative), variable names, add, mult and let forms."
      },
      {
        "id": "R2",
        "text": "In let, assign variables left to right; later expressions in the same let see earlier assignments, and a name may be reassigned."
      },
      {
        "id": "R3",
        "text": "Use lexical scoping: a lookup finds the innermost active binding, and a let's bindings are removed when it finishes."
      },
      {
        "id": "R4",
        "text": "Return the integer value of the whole expression."
      },
      {
        "id": "R5",
        "text": "Do not modify the input string."
      }
    ]
  },
