    "value": [
      {
        "id": "R1",
        "text": "Every booking is accepted; intervals are half-open, so touching intervals do not overlap."
      },
      {
        "id": "R2",
        "text": "After each book call, return the maximum, over all moments, of the number of accepted bookings covering it."
      },
      {
        "id": "R3",
        "text": "The trace adapter solve(operation_names, argument_lists) creates one MyCalendarThree and returns null followed by each book result."
      },
      {
        "id": "R4",
        "text": "Do not modify the trace input lists; return a fresh result list."
      }
    ]
  },
