    "value": [
      {
        "id": "R1",
        "text": "Parse element names as an uppercase letter followed by zero or more lowercase letters."
      },
      {
        "id": "R2",
        "text": "A count after an element or a closing parenthesis applies to that element or that whole group; a missing count means 1."
      },
      {
        "id": "R3",
        "text": "Nested groups multiply: an atom's total contribution is its own count times the counts of every group that encloses it."
      },
      {
        "id": "R4",
        "text": "Output elements sorted by name (ordinary string order), each followed by its total only when the total exceeds 1."
      },
      {
        "id": "R5",
        "text": "Do not modify the input; return a new string."
      }
    ]
  },
