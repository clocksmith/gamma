    "value": [
      {
        "id": "R1",
        "text": "Treat each booking as a half-open interval; touching intervals do not overlap."
      },
      {
        "id": "R2",
        "text": "Accept a booking only if, after adding it, no point is covered by three or more accepted bookings."
      },
      {
        "id": "R3",
        "text": "A rejected booking returns false and leaves the state unchanged."
      },
      {
        "id": "R4",
        "text": "The trace adapter solve(operation_names, argument_lists) creates one MyCalendarTwo and returns null followed by each book result."
      },
      {
        "id": "R5",
        "text": "Do not modify the trace input lists; return a fresh result list."
      }
    ]
  },
