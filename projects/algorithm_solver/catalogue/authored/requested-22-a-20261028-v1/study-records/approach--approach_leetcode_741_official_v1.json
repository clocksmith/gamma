    "status": "present",
    "value": [
      "best[r1][r2] after step t is the maximum cherries collected by two partial paths ending at (r1, t-r1) and (r2, t-r2), or the sentinel if impossible.",
      "Only states with r1 <= r2 are stored; the transitions keep that ordering.",
      "A shared cell's cherry is added once."
    ]
  },
