  "value": {
   "reference": "keep a list of (name, args, kwargs) entries in recency order and find a call by comparing it with every entry using a recursive type-aware equality",
   "candidate_design": "create_cache_key: serialise the call to one canonical string (type tags, objects with sorted keys), so equal calls give equal strings; an insertion-ordered map (OrderedDict / Map) gives O(1) LRU moves and evictions",
   "complexity_target": "O(size of the call) per call/O(capacity * key size) space"
  },
