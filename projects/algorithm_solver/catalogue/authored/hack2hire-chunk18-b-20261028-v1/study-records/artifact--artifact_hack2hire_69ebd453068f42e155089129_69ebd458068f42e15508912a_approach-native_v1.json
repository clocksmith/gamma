 "nativeMetadata": {
  "status": "present",
  "value": {
   "reference": "try every k from 0 to n and walk the stairs floor by floor with the energy rule",
   "candidate_design": "feasibility is monotone in k, so binary search the smallest feasible k (k * e1 - (n - k - 1) * e2 > 0, or k = n); scan k upward from there, cutting a stair walk off once it reaches the best time and stopping when k * t1 + (n - k) alone reaches the best, since every stair floor costs at least 1",
   "complexity_target": "O(log n + n^2) worst case time/O(1) space"
  },
