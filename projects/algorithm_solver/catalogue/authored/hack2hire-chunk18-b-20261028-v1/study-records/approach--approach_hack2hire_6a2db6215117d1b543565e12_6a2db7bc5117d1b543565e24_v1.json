   }
  ]
 },
 "chooseWhen": {
  "status": "present",
  "value": [
   "Memoising calls whose arguments are unhashable or order-insensitive"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk18-b-20261028-v1/study-content.json",
