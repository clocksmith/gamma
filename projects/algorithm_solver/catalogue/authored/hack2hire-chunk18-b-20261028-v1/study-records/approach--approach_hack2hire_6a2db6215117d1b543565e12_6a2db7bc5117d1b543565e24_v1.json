   }
  ]
 },
 "tradeoffs": {
  "status": "present",
  "value": [
   "A canonical string is easy to persist and compare; nested tuples avoid string building but cannot distinguish True from 1 in Python"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk18-b-20261028-v1/study-content.json",
