   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "two calls have equal keys exactly when they are the same call",
   "the map iteration order is least to most recently used"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk18-b-20261028-v1/study-content.json",
