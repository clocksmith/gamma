 "nativeMetadata": {
  "status": "present",
  "value": {
   "reference": "for t from the largest possible down, test the assignment with augmenting-path maximum flow (source to nodes with capacity t, node to type 1, type to sink its count)",
   "candidate_design": "count each type with a hash map; a type can serve at most min(count, m) nodes, and t per node is feasible exactly when the sum of min(count, m) is at least m * t (the counting function is concave), so t = floor(sum / m)",
   "complexity_target": "O(n) time/O(distinct types) space"
  },
