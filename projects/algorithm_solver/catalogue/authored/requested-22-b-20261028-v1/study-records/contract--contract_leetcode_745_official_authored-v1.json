    "value": [
      {
        "id": "R1",
        "text": "The constructor receives the word list once; later queries refer to positions in that list."
      },
      {
        "id": "R2",
        "text": "f(pref, suff) returns the index of a word that has pref as a prefix and suff as a suffix (the whole word may serve as either)."
      },
      {
        "id": "R3",
        "text": "When several words match, return the largest index; duplicated words therefore resolve to their last occurrence."
      },
      {
        "id": "R4",
        "text": "Return -1 when no word matches."
      },
      {
        "id": "R5",
        "text": "Do not modify the word list or query strings; each object answers only for its own words."
      }
    ]
  },
