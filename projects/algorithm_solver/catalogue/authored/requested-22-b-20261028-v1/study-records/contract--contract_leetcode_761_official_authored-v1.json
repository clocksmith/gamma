      {
        "id": "R1",
        "text": "The input is special: equal counts of 1 and 0, and no prefix with more 0s than 1s."
      },
      {
        "id": "R2",
        "text": "A move swaps two special substrings that are adjacent in the string."
      },
      {
        "id": "R3",
        "text": "Return the lexicographically largest string reachable with any number of moves."
      },
      {
        "id": "R4",
        "text": "Return a new string; the input is unchanged."
      }
