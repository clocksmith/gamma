    "status": "present",
    "value": [
      {
        "id": "R1",
        "text": "Regions are maximal groups of infected cells connected up, down, left or right, ignoring cells already walled off."
      },
      {
        "id": "R2",
        "text": "Each day, choose the region whose set of distinct threatened healthy neighbours is largest."
      },
      {
        "id": "R3",
        "text": "The walls needed for that region equal the number of (infected cell, healthy neighbour) adjacent pairs, so a healthy cell touching it on two sides needs two walls."
      },
      {
        "id": "R4",
        "text": "The walled region becomes inert; every other region infects all its healthy neighbours at the end of the day."
      },
      {
        "id": "R5",
        "text": "Stop when no region threatens a healthy cell; return the sum of walls built."
      },
      {
        "id": "R6",
        "text": "Do not modify the input grid."
      }
    ]
  },
