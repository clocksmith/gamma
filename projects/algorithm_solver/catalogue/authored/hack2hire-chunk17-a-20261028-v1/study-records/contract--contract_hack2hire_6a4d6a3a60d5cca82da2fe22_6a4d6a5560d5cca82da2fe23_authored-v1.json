 "variantLabel": {
  "status": "present",
  "value": "Single variant: two-type reader-style lock with FIFO admission",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk17-a-20261028-v1/study-content.json",
