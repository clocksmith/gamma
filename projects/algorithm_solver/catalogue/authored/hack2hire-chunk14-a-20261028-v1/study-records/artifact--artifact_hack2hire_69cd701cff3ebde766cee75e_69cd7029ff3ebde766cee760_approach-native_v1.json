  "value": {
   "reference": "for every row timestamp and every code, scan all records for the latest timestamp not after the row (last arrival wins on a tie)",
   "candidate_design": "map each code to its column, bucket records by timestamp in a hash map, sort the distinct timestamps and sweep them carrying the current value of every column",
