   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "each frontier contains exactly the tasks whose remaining in-degree became 0 in the previous round",
   "emitted task count equals n unless there is a cycle"
  ],
  "provenance": [
   {
