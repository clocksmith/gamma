  "value": {
   "reference": "per query, walk up to the root keeping letter parities and count prefixes with at most one odd letter",
   "candidate_design": "root-to-node parity masks P; the path q..v has mask P[q] xor P[parent(v)]; an iterative DFS keeps counts of the masks of the strict ancestors (plus 0 for v = root) and looks up P[q] and its 26 one-bit neighbours",
   "complexity_target": "O((n + m) * 26) time, O(n) space"
  },
