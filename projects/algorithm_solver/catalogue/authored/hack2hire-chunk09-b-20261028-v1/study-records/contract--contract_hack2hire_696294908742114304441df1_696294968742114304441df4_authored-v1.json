   }
  ]
 },
 "statement": {
  "status": "present",
  "value": "existingAssociations and newAssociations are lists of [companyId, contactId, role] triples. Validate the new associations in order against the current set, which starts as the existing associations. Rule 1: if the same triple is in the current set, the result is \"ALREADY_EXISTS\". Rule 2: otherwise, if some association in the current set has the same companyId and role (necessarily with another contact), the result is \"ROLE_TAKEN\". Otherwise the result is \"VALID\" and the triple is added to the current set, so later new associations see it. Return the list of results.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk09-b-20261028-v1/contracts.json",
