  "value": {
   "reference": "enumerate every subset of the neighborhood's free properties as a bitmask and take the minimum of (size, total, sorted ids)",
   "candidate_design": "free properties per neighborhood sorted by id; the smallest feasible size comes from the largest capacities; backtracking over combinations of that size in id order keeps the first one with the smallest total",
   "complexity_target": "O(C(m, s) * s) per booking for m free properties in the neighborhood/O(p) space"
