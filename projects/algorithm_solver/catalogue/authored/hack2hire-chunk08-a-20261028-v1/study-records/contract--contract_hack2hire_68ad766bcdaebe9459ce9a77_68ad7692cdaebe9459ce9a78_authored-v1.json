 "statement": {
  "status": "present",
  "value": "DetectionSystem(maxRequests, windowSeconds) receives requests in non-decreasing timestamp order. isBot(ip, timestamp) records the request and returns true when the number of requests from ip with timestamp in [timestamp - windowSeconds + 1, timestamp], counting this one, is greater than maxRequests. Flagged requests still count toward later windows.",
  "provenance": [
