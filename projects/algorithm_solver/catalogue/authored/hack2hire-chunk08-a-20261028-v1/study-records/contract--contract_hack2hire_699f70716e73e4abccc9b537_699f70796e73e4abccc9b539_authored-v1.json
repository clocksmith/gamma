 },
 "statement": {
  "status": "present",
  "value": "PriorityExpiryLRUCache(capacity) holds at most capacity keys. Time is passed explicitly and never decreases across calls. get(key, currentTime): if key is absent return -1; if its expiryTime <= currentTime remove it and return -1; otherwise mark it accessed now and return its value. set(key, value, priority, expiryTime, currentTime): if key is present (expired or not) replace its value, priority and expiryTime and mark it accessed now. Otherwise, if the cache is full, evict exactly one item first: if some item has expiryTime <= currentTime, the one with the smallest expiryTime; otherwise the one with the smallest priority; ties in either case go to the least recently accessed item (accesses are ordered by call order). Then insert the new item, accessed now.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk08-a-20261028-v1/contracts.json",
    "sha256": "a475a05a254c28bcbe408996482bb2fff51af43b571d12bc76b9f7074d39813a",
    "selector": "/problems/4/inferred_spec"
   }
  ]
 },
 "contentScope": "authored",
 "requirements": {
  "status": "present",
  "value": [
   "PriorityExpiryLRUCache(capacity) holds at most capacity keys.",
   "Time is passed explicitly and never decreases across calls.",
   "get(key, currentTime): if key is absent return -1; if its expiryTime <= currentTime remove it and return -1; otherwise mark it accessed now and return its value.",
   "set(key, value, priority, expiryTime, currentTime): if key is present (expired or not) replace its value, priority and expiryTime and mark it accessed now.",
   "Otherwise, if the cache is full, evict exactly one item first: if some item has expiryTime <= currentTime, the one with the smallest expiryTime; otherwise the one with the smallest priority; ties in either case go to the least recently accessed item (accesses are ordered by call order).",
   "Then insert the new item, accessed now."
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk08-a-20261028-v1/contracts.json",
