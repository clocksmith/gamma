   }
  ]
 },
 "statement": {
  "status": "present",
  "value": "transactions is a list of six-string rows. A payment row is [paymentId, \"PAYMENT\", paymentType, \"\", timestamp, amount]; a refund row is [refundId, \"REFUND\", \"\", linkedPaymentId, timestamp, amount]. Timestamps and amounts are decimal integer strings. Every refund links to a payment in the list, and the refunds of one payment never exceed its amount. The refundable balance of a payment is its amount minus the amounts of the refunds linked to it. refundAmount is a non-negative integer. Visit payments in this order: paymentType CREDIT first, then CREDIT_CARD, then PAYPAL, then every other type in code-point order of the type name; within one type, larger timestamp first; then smaller paymentId in code-point order. Give each visited payment min(its refundable balance, the amount still to allocate). Return [paymentId, allocated] for every payment that receives a positive amount, in visiting order. If the refundable balances do not cover refundAmount, everything refundable is allocated and the rest is left unallocated.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk08-a-20261028-v1/contracts.json",
