  "value": {
   "reference": "try every sign assignment (a[0] must be plus) and keep the largest number of minus signs whose prefix sums all stay positive",
   "candidate_design": "scan left to right, tentatively negate every element and push it on a max-heap; while the running sum is not positive, flip the largest negated value back to plus; the heap size at the end is the answer",
   "complexity_target": "O(n log n) time/O(n) space"
