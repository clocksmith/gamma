 "invariants": {
  "status": "present",
  "value": [
   "left[c] = min(arr[c], left[c - 1] + 1) is the minimum of arr[i] + c - i over i <= c",
   "a peak k fits at c exactly when k <= min(c + 1, n - c, left[c], right[c])"
  ],
  "provenance": [
   {
