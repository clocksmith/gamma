 },
 "statement": {
  "status": "present",
  "value": "Vector2D(vec) copies a list of integer rows (rows may be empty). next() returns the next integer in row-major order and is only called when one remains. hasNext() reports whether one remains. remove() deletes the element most recently returned by next() and returns true; when next() has not been called yet, or that element was already removed, it changes nothing and returns false. Removal does not change which element next() returns. getVector() returns the current rows (every original row, possibly empty) without the removed elements. Every method call is answered in call order on one instance; void methods return nothing.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk11-a-20261028-v1/contracts.json",
