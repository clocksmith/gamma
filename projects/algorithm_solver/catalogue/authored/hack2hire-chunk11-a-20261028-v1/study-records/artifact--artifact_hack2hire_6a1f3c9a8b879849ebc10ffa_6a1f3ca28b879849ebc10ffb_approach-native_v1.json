  "value": {
   "reference": "translate the pattern into a regular expression (\"?\" to \".\", \".\" to \".+\") and full-match every word",
   "candidate_design": "per word, a rolling boolean dynamic programme over pattern positions: a \".\" cell is true when the previous character row was true at the same or the previous pattern position",
