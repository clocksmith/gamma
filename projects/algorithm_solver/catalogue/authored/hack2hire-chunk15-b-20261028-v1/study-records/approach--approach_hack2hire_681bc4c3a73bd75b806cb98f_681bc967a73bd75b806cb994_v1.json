  ]
 },
 "tradeoffs": {
  "status": "present",
  "value": [
   "Linked lists give O(k) queries; a heap or balanced tree handles arbitrary score jumps at O(log m) per update"
  ],
  "provenance": [
   {
    "repository": "gamma",
