  "value": {
   "reference": "apply each transformation eagerly to a copied array and search it linearly",
   "candidate_design": "compose all transformations into one affine map a x + b; indexOf inverts it ((target - b) / a when divisible) and looks the preimage up in a first-index hash map; a = 0 means every element maps to b",
