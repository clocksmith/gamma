 },
 "statement": {
  "status": "present",
  "value": "requests is a list of [sequenceNumber, requestString] pairs with unique sequence numbers. Process them in order and return one response string per request. \"v1/REGISTER/{user}/{initialBalance}\" registers user with that balance and answers \"OK\", or \"ERROR\" when user already exists. \"v1/FRIEND_REQUEST/{fromUser}/{toUser}\" answers \"ERROR\" when either user is unregistered, the users are equal or already friends; otherwise it stores a pending request under this request's sequence number and answers \"OK\". \"v1/ACCEPT_FRIEND_REQUEST/{requestSequenceNumber}\" answers \"OK\" and makes the two users of that request friends when the number names a still-pending friend request (the request is then no longer pending, and accepting it when the users are already friends through another request is still \"OK\"); otherwise \"ERROR\". \"v1/TRANSFER/{fromUser}/{toUser}/{amount}\" moves amount from fromUser to toUser and answers \"OK\" when both are registered, distinct, friends, and fromUser's balance is at least amount; otherwise \"ERROR\" with no change. \"v1/BALANCE/{user}\" answers the user's balance in decimal, or \"ERROR\" when unregistered.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk11-b-20261028-v1/contracts.json",
