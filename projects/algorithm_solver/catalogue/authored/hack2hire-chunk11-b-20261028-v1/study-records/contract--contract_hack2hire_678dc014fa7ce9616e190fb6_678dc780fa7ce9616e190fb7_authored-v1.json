   }
  ]
 },
 "statement": {
  "status": "present",
  "value": "Because a function cannot travel in JSON, the filter is a name. FilterIterator(nums, filterName) iterates over nums, where filterName is one of \"even\", \"odd\", \"positive\", \"negative\" or \"nonzero\" and selects the elements satisfying that predicate. hasNext() returns whether a selected element remains; next() returns the next selected element in original order and moves past it. next() is only called when hasNext() would return true. The iterator never changes nums. Every method call is answered in call order on one instance; void methods return nothing.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk11-b-20261028-v1/contracts.json",
