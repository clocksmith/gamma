   }
  ]
 },
 "tradeoffs": {
  "status": "present",
  "value": [
   "Lazy heaps keep stale entries until they surface, so memory is O(n) rather than O(windowSize)"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk09-a-20261028-v1/study-content.json",
