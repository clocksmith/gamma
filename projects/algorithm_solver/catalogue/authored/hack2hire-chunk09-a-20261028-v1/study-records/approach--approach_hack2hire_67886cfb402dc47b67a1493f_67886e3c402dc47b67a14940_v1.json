   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "the top heap holds exactly the k largest (value, index) pairs of the window",
   "topSum + restSum equals the window sum"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk09-a-20261028-v1/study-content.json",
