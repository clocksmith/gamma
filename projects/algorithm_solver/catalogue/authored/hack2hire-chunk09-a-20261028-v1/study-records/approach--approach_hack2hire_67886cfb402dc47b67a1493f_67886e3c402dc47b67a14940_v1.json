   }
  ]
 },
 "chooseWhen": {
  "status": "present",
  "value": [
   "Large windows where re-sorting every window is too slow"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk09-a-20261028-v1/study-content.json",
