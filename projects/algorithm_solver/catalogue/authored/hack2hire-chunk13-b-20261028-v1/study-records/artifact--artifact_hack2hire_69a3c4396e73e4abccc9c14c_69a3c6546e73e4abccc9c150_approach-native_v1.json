 "nativeMetadata": {
  "status": "present",
  "value": {
   "reference": "brute force over integer keys: for each shard find the last key in its range already covered by limit kept shards by counting coverage key by key, then fill gaps by a linear walk",
   "candidate_design": "sorted arrays of kept starts and ends; coverage at x is (#starts <= x) - (#ends < x), which is non-increasing from the current start, so a binary search over candidate points finds the trimmed start",
   "complexity_target": "O(n log n + n * insertion cost) time/O(n) space"
  },
