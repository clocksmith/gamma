  "value": {
   "reference": "generate the Cartesian product of the option sets for each sentence, de-duplicate and sort the joined strings",
   "candidate_design": "group wordSet by sorted-letter signature; for each word take its sorted option list, then expand the product position by position in order; because anagrams have equal length the product order is already sorted",
   "complexity_target": "O(sum of output length + wordSet letters log) time/O(output) space"
