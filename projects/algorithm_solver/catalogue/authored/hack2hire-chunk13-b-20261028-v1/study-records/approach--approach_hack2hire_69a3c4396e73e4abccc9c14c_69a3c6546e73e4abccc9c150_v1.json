   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "no key is covered by more than limit kept shards",
   "kept ranges only shrink before the gap fill, which only extends starts backward"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk13-b-20261028-v1/study-content.json",
