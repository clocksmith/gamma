   }
  ]
 },
 "statement": {
  "status": "present",
  "value": "shards lists strings \"<id>:<start>:<end>\" with distinct ids and 0 <= start <= end; limit >= 1. Process shards in order of (start, end, id). Each shard keeps the keys [s, end] where s is the smallest key >= start such that every key in [s, end] is covered by fewer than limit already kept shards; if no such key exists (s > end) the shard is dropped. Then sort kept shards by (start, end, id) using the trimmed starts and walk them with the largest end seen so far: when a shard starts more than one key after it, its start moves back to that end plus one, filling the gap. Return the kept shards as \"<id>:<start>:<end>\" strings in (start, end, id) order of their final ranges.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk13-b-20261028-v1/contracts.json",
