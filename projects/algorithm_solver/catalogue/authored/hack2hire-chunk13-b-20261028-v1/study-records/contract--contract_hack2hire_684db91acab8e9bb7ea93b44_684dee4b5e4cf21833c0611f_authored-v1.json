   }
  ]
 },
 "statement": {
  "status": "present",
  "value": "intervals is a list of non-overlapping half-open integer intervals [start, end) with start < end, in arbitrary order; the flattened sequence lists the integers of the first interval in increasing order, then those of the second, and so on. Remove the point at 0-based position idx of that sequence and return the intervals that remain, in input order: the interval holding the point is replaced by [start, p) and [p + 1, end) in that order, omitting either piece when it is empty. When idx is at least the number of covered points, return the intervals unchanged (as a fresh list).",
  "provenance": [
   {
    "repository": "gamma",
