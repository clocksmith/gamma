   }
  ]
 },
 "statement": {
  "status": "present",
  "value": "WeightedCache(maxTotalWeight) creates an empty cache. put(key, value, weight) inserts the key or replaces its value and weight (counting as its newest write); then, while the total weight exceeds maxTotalWeight, it evicts the item with the largest weight, breaking ties by evicting the item written least recently (the item just written can itself be evicted). get(key) returns the stored value, or -1 if the key is absent; it does not change the cache. Every method call is answered in call order on one instance; void methods return nothing.",
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk14-b-20261028-v1/contracts.json",
