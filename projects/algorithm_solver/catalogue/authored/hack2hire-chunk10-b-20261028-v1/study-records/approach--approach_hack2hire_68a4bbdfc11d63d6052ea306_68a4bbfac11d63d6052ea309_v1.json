   }
  ]
 },
 "hints": {
  "status": "present",
  "value": [
   "Keep each finished session with the compensation in force when it started.",
   "Apply a pending promotion at the first entry whose timestamp reaches its start; reset the stint total there.",
   "Sessions are disjoint and sorted, so binary search finds the first one overlapping the query window."
  ],
