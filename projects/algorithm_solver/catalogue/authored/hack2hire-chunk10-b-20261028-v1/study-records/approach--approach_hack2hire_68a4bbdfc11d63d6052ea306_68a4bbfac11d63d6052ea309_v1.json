 "tradeoffs": {
  "status": "present",
  "value": [
   "Sorting on each ranking call is simple but O(w log w); a balanced tree per position would make it O(n log w) at the cost of updates on every exit"
  ],
  "provenance": [
   {
    "repository": "gamma",
    "revision": null,
    "path": "projects/algorithm_solver/catalogue/authored/hack2hire-chunk10-b-20261028-v1/study-content.json",
