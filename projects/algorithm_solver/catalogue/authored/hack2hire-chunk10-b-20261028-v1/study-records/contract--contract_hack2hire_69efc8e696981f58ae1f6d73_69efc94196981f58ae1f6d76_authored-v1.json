   }
  ]
 },
 "contentScope": "authored",
 "requirements": {
  "status": "present",
  "value": [
   "TaskManager() starts empty; every call carries a timestamp and timestamps strictly increase.",
   "addTask(timestamp, name, priority) stores a task and returns its id \"taskId<n>\" with n = 1, 2, ..",
   "in creation order (duplicates allowed).",
   "updateTask(timestamp, taskId, name, priority) replaces both fields and returns true, or returns false for an unknown id.",
   "getTask(timestamp, taskId) returns \"<name>(<priority>)\", or \"\" for an unknown id.",
   "searchTasks(timestamp, nameFilter, maxResults) returns the ids of tasks whose current name contains nameFilter (case-sensitive substring), ordered by priority descending and then creation order, at most maxResults of them.",
   "listTasksSorted(timestamp, limit) returns the first limit ids of all tasks in the same order.",
   "addUser(timestamp, userId, quota) adds a user and returns true, or false when the user exists.",
   "An assignment is active at time t while finishTime > t.",
   "assignTask(timestamp, taskId, userId, finishTime) returns false when the task or user is unknown, the user already has an active assignment of that task, or the user's active assignments already number quota; otherwise it records the assignment and returns true.",
   "getUserTasks(timestamp, userId) returns the task ids of the user's active assignments ordered by finishTime and then assignment order ([] for an unknown user)."
  ],
  "provenance": [
