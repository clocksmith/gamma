   }
  ]
 },
 "invariants": {
  "status": "present",
  "value": [
   "each worker alternates entry and exit, so at most one session is open",
   "finished totals only grow",
   "the stint total counts only sessions started under the current position",
   "merged double-pay intervals are disjoint and sorted"
  ],
