  "invariants": {
    "status": "present",
    "value": [
      "Find the fewest synchronous ticks moving each car in four directions or waiting until both reach their own marked destination. Walls are impassable. Cars cannot share a cell or swap endpoints of an edge in one tick. Reaching a destination does not freeze movement. These collision and timing rules are explicit inferences because the preview stops before them.",
      "Observing a result must not change earlier returned snapshots or mutate input containers."
    ],
    "provenance": [
      {
        "repository": "gamma",
        "revision": null,
