  "decision": "answered",
  "code": "class Solution:\n    def continuousSubarrays(self, nums: List[int]) -> int:\n        ans = i = 0\n        sl = SortedList()\n        for x in nums:\n            sl.add(x)\n            while sl[-1] - sl[0] > 2:\n                sl.remove(nums[i])\n                i += 1\n            ans += len(sl)\n        return ans\n",
