{
  "schema_version": "bits-paired-switch-contract-v3",
  "study_id": "paired-switch-v1",
  "status": "staged_development_gates_no_experiment_started",
  "separate_from_existing_papers": true,
  "existing_paper_release_order": {
    "lead": "bits-sixbit-capacity-and-certificates",
    "companion": "bits-three-objectives"
  },
  "stage_order": [
    "stage1_qualify_ordinary_helper",
    "stage2_earn_rung2_prediction",
    "stage3_rung3_dev_gate_exclusive_gpu"
  ],
  "stage1_helper_qualification": {
    "status": "REQUIRED_BEFORE_STAGE2_AND_STAGE3",
    "arms": ["no_helper", "ordinary_named_fn"],
    "require_strict_solve_rate_gain_over_no_helper": true,
    "min_families_with_executed_helper_solve": 2,
    "required_utility_regimes": [
      "useful_once",
      "repeatedly_useful",
      "irrelevant_decoy"
    ],
    "failure_rule": "If the ordinary helper cannot beat no_helper with executed helper solves across multiple families, the fixture cannot test the alias; stop and fix the fixture."
  },
  "stage2_rung2_prediction": {
    "status": "REQUIRED_BEFORE_STAGE3",
    "predictor_scope": "frozen_helper_agnostic_pre_switch_transcript_only",
    "train_dev_families": [
      "duplicate_handling",
      "interval_processing",
      "graph_traversal"
    ],
    "separate_validation_dev_families": [
      "string_parsing",
      "window_aggregation",
      "grid_flood"
    ],
    "setup_cost_per_step_attempt_equiv": 0.05,
    "min_net_benefit_to_adapt": 0.25,
    "helper_length_baseline_min_lines": 12,
    "comparators": [
      "always_install",
      "never_install",
      "simple_helper_length"
    ],
    "require_beats_all_comparators_on_separate_dev_families": true,
    "require_predicts_both_losses_and_wins": {
      "min_win_recall": 0.6,
      "min_loss_recall": 0.6
    }
  },
  "arms": [
    {
      "name": "frozen_alias",
      "output_row": "original",
      "input_embedding": "original",
      "uses_alias_token": true
    },
    {
      "name": "score_only_alias",
      "output_row": "adapted",
      "input_embedding": "original",
      "uses_alias_token": true
    },
    {
      "name": "score_and_input_alias",
      "output_row": "adapted",
      "input_embedding": "adapted",
      "uses_alias_token": true
    },
    {
      "name": "ordinary_named_fn",
      "output_row": "none_ordinary_tokens",
      "input_embedding": "none_ordinary_tokens",
      "uses_alias_token": false
    }
  ],
  "reserved_token": {
    "symbol": "<H0>",
    "bind_once_per_session": true,
    "require_zero_prefix_occurrences": true
  },
  "adaptation_policy": {
    "optimizer": "AdamW",
    "learning_rate": 0.05,
    "weight_decay": 0.0,
    "grad_clip_norm": 1.0,
    "setup_budget_steps": 16,
    "matched_loss_positions_for_adapted_arms": true,
    "score_only_trains_same_loss_with_frozen_input_row": true,
    "require_backbone_and_other_rows_bit_exact": true,
    "allow_only_switch_visible_information": true
  },
  "numerical_verification_gates": {
    "historical_kv_max_abs_diff_max": 0.0,
    "pre_call_forced_max_abs_diff_max": 0.0,
    "rebuild_parity_tol_fp32": 0.0001,
    "rebuild_parity_tol_bf16": 0.01,
    "require_fresh_boundary_rescoring": true
  },
  "search_budgets": {
    "narrow_attempt_cap": 2,
    "wide_attempt_cap": 32,
    "max_new_tokens_per_attempt": 384,
    "verifier_timeout_seconds": 2.0,
    "total_budget": {
      "cli_argument": "--arm-budget-seconds",
      "unit": "synchronized_elapsed_seconds_on_one_fixed_exclusive_gpu",
      "scope": "one_identical_limit_per_problem_cap_and_arm",
      "shared_prefix_prefill": "measure_once_charge_in_full_to_each_arm",
      "verifier_admission": "reserve_full_verifier_timeout_charge_actual_elapsed",
      "late_result": "unsolved_record_actual_overrun"
    },
    "charge_all_phases": [
      "helper_proposal",
      "adaptation_setup",
      "generation",
      "verification",
      "retries",
      "unsuccessful_branches"
    ],
    "keep_refusals_and_timeouts_in_denominator": true
  },
  "rung3_promotion_bar": {
    "paired_by": ["problem_id", "switch_point_id"],
    "require_exclusive_gpu": true,
    "min_worthwhile_solve_rate_gain": 0.05,
    "bootstrap_ci_level": 0.95,
    "require_family_bootstrap_ci_lower_gt_zero": true,
    "min_families_with_executed_helper_solve": 2,
    "dev_gate_pass_grants": "ELIGIBLE_FOR_SEALED_DECISION_ONLY_NOT_RUNG3_CLAIM",
    "holdout_status": "SEALED",
    "stopping_rule": "Freeze minimum meaningful win before Stage 3 dev gate. If score_and_input_alias fails to beat BOTH score_only_alias and ordinary_named_fn by family, stop. If it passes on development, that earns a decision on whether to authorize one untouched sealed run, not a Rung 3 claim.",
    "attribution_rules": {
      "score_only_beats_frozen": "supports_better_action_selection_only",
      "input_representation_claim_requires_all": [
        "stage1_ordinary_helper_qualified_over_no_helper",
        "stage2_frozen_predictor_earned_on_separate_dev_families",
        "score_and_input_beats_equally_funded_score_only_in_free_search",
        "forced_call_pre_diff_zero_and_post_diff_nonzero",
        "holds_against_ordinary_named_fn_baseline",
        "verified_solves_execute_helper_at_runtime"
      ],
      "if_ordinary_named_fn_matches_installation": "retain_helper_reuse_as_explanation_and_stop"
    }
  },
  "rung4_gate": {
    "status": "LOCKED_PENDING_RUNG3_WIN",
    "prerequisite": "Cheaper paired-switch experiment must establish a verified search benefit worth preserving at Rung 3.",
    "required_comparators_if_unlocked": [
      "unused_slot_method",
      "optimized_replay_retaining_completed_verifier_work_and_valid_cached_prefixes"
    ]
  }
}
