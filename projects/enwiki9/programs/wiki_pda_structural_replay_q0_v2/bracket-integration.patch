--- a/src/models/bracket.cpp
+++ b/src/models/bracket.cpp
@@ -56,5 +56,12 @@ void Bracket::ByteUpdate() {
       probs_[brackets_[active]] = p;
     }
   }
+  wiki_pda_.Observe(static_cast<unsigned char>(byte_));
+  unsigned char expected = 0;
+  float probability = 0.0f;
+  if (wiki_pda_.NextPrediction(&expected, &probability)) {
+    probs_ = (1.0f - probability) / 255.0f;
+    probs_[expected] = probability;
+  }
   ByteModel::ByteUpdate();
 }
