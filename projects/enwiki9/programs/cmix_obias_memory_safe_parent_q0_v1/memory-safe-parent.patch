+    if (path == NULL || path[0] == '\0') return;
+    FILE* marker = fopen(path, "ab");
+    if (marker == NULL) {
+      fprintf(stderr, "cannot open resource phase marker stream\n");
+      exit(EXIT_FAILURE);
