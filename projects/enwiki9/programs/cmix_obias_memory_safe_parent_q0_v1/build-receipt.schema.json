{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma://enwiki9/cmix-obias-memory-safe-parent/build-receipt/v1",
  "title": "Memory-safe CMIX parent independent build receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "operational_status",
    "build_id",
    "program_reference",
    "source",
    "build",
    "outputs"
  ],
  "properties": {
    "schema": {
      "const": "gamma.enwiki9.cmix_obias_memory_safe_parent.build_receipt.v1"
    },
    "candidate_id": {
      "const": "cmix_obias_memory_safe_parent_q0_v1"
    },
    "operational_status": {
      "const": "terminal"
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "program_reference": {
      "$ref": "#/$defs/projectPath"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outer_commit",
        "tracked_tree",
        "source_archive",
        "patch",
        "input_files"
      ],
      "properties": {
        "outer_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "tracked_tree": {
          "$ref": "#/$defs/gitObject"
        },
        "source_archive": {
          "$ref": "#/$defs/artifact"
        },
        "patch": {
          "$ref": "#/$defs/artifact"
        },
        "input_files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/sourceFile"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_build_root_created",
        "cache_mode",
        "build_root",
        "environment",
        "tools",
        "compile_flags",
        "linker_flags",
        "steps"
      ],
      "properties": {
        "clean_build_root_created": {
          "const": true
        },
        "cache_mode": {
          "const": "disabled"
        },
        "build_root": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tools": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/externalArtifact"
          }
        },
        "compile_flags": {
          "$ref": "#/$defs/stringArray"
        },
        "linker_flags": {
          "$ref": "#/$defs/stringArray"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cmix",
        "head"
      ],
      "properties": {
        "cmix": {
          "$ref": "#/$defs/nonemptyArtifact"
        },
        "head": {
          "$ref": "#/$defs/nonemptyArtifact"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/projectPath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nonemptyArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "bytes": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "externalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_path",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "logical_path": {
          "$ref": "#/$defs/projectPath"
        },
        "path": {
          "$ref": "#/$defs/projectPath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "environment_delta",
        "stdout",
        "stderr",
        "returncode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "$ref": "#/$defs/stringArray"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "environment_delta": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "stdout": {
          "$ref": "#/$defs/artifact"
        },
        "stderr": {
          "$ref": "#/$defs/artifact"
        },
        "returncode": {
          "const": 0
        }
      }
    }
  }
}
