{
  "id": "cmix21_text_mmap_paq9_ppmd8g_v1",
  "family": "cmix21_mmap",
  "status": "candidate",
  "description": "cmix v21 forced text-mode wrapper using the mmap allocator, PAQ8 level 9, and an 8000 MB PPMD heap. The binary and english.dic are gzip-compressed and counted toward program_size.",
  "parent": "cmix21_text_mmap_paq9_v1",
  "hypothesis": "PAQ8 level 9 passed 1K memory and determinism but crossed the memory ceiling at the 250K compression gate. Capping PPMD at 8000 MB should keep the same cmix21 text path within memory at real prefix scope while preserving enough archive quality to remain a 10.95 prospect.",
  "deps": [
    "C++ runtime for the vendored cmix binary",
    "POSIX mmap and temporary filesystem space"
  ],
  "source": {
    "tree": "projects/enwiki9/external/cmix21-sidecar",
    "binary": "projects/enwiki9/programs/cmix21_text_mmap_paq9_ppmd8g_v1/cmix.bin.gz",
    "dictionary": "projects/enwiki9/programs/cmix21_text_mmap_paq9_ppmd8g_v1/english.dic.gz",
    "build": "g++ -std=c++14 -Wall -O3 -DCMIX_PAQ8_LEVEL=9 -DCMIX_PPMD_MEMORY_MB=8000"
  },
