+void Encoder::KhWriteRaw(int bit, unsigned int final_p) {
+  KhResRecord r;
+  r.final_p = (uint16_t)final_p;
+  r.flags = (uint8_t)((bit & 1) | 0x04u);
+  r.reserved = 0;
+  for (int i = 0; i < 26; ++i) r.half[i] = 0;
+  std::fwrite(&r, sizeof(r), 1, kh_res_f_);
+  ++kh_bit_index_;
+}
