 // for aligned data
 template <class T> void alloc1(T*&data, int c,T*&ptr,const int align=16) {
   const size_t extra=(align+sizeof(T)-1)/sizeof(T);
+#ifdef GAMMA_FILEBACKED_FXCM
+  if (c < 0 || static_cast<size_t>(c) > SIZE_MAX / sizeof(T) - extra) {
+    ::gamma_filebacked_fxcm::Fail(
+        ::gamma_filebacked_fxcm::FailureCode::allocation,
+        "aligned allocation size overflow");
+  }
+  const size_t bytes = (static_cast<size_t>(c) + extra) * sizeof(T);
+  if (bytes >= ::gamma_filebacked_fxcm::kMinimumBackedBytes) {
+    ptr = static_cast<T*>(::gamma_filebacked_fxcm::AllocateBacked(
+        bytes, static_cast<size_t>(c) * sizeof(T),
+        static_cast<size_t>(align)));
+  } else
+#endif
+  {
   ptr=(T*)calloc((size_t)c+extra, sizeof(T));
   if (!ptr) exit(1);
   AdviseHugePages(ptr, ((size_t)c+extra)*sizeof(T));
+  }
   data=(T*)(((uintptr_t)ptr+(align-1)) & ~(uintptr_t)(align-1));
 }
