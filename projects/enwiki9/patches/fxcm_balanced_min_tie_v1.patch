       __attribute__ ((noinline)) U8* get(U16 ch,int keep) {
 
   if (chk[last&15]==ch) return &bh[last&15][0];
-  int b=0xffff, bi=0;
+  int b=0xffff, ties=0, bi=0;
 
   for (int i=0; i<A; ++i) {
