+#ifdef CMIX_MIXREGRET_TRACE
+namespace {
+void WriteMixregretU16(FILE* file, std::uint16_t value) {
+  const unsigned char bytes[2] = {
+      static_cast<unsigned char>(value),
+      static_cast<unsigned char>(value >> 8)};
+  if (std::fwrite(bytes, 1, sizeof(bytes), file) != sizeof(bytes)) {
+    std::perror("CMIX_MIXREGRET_TRACE row");
+    std::abort();
+  }
+}
+
+void WriteMixregretU32(FILE* file, std::uint32_t value) {
+  unsigned char bytes[4];
+  for (unsigned int i = 0; i < 4; ++i) {
+    bytes[i] = static_cast<unsigned char>(value >> (8 * i));
+  }
+  if (std::fwrite(bytes, 1, sizeof(bytes), file) != sizeof(bytes)) {
+    std::perror("CMIX_MIXREGRET_TRACE header");
+    std::abort();
+  }
+}
+
+void WriteMixregretU64(FILE* file, std::uint64_t value) {
+  unsigned char bytes[8];
+  for (unsigned int i = 0; i < 8; ++i) {
+    bytes[i] = static_cast<unsigned char>(value >> (8 * i));
+  }
+  if (std::fwrite(bytes, 1, sizeof(bytes), file) != sizeof(bytes)) {
+    std::perror("CMIX_MIXREGRET_TRACE header");
+    std::abort();
+  }
+}
+}  // namespace
+
+void Predictor::InitializeMixregretTrace() {
+  const char* path = std::getenv("CMIX_MIXREGRET_TRACE");
+  if (path == nullptr || path[0] == '\0') return;
+  mixregret_trace_file_ = std::fopen(path, "wb+");
+  if (mixregret_trace_file_ == nullptr) {
+    std::perror("CMIX_MIXREGRET_TRACE");
+    std::abort();
+  }
+  std::setvbuf(mixregret_trace_file_, nullptr, _IOFBF, 1U << 20);
+  const unsigned char magic[8] = {'M', 'I', 'X', 'R', 'G', 'T', '1', '\0'};
+  if (std::fwrite(magic, 1, sizeof(magic), mixregret_trace_file_) !=
+      sizeof(magic)) {
+    std::perror("CMIX_MIXREGRET_TRACE header");
+    std::abort();
+  }
+  WriteMixregretU32(mixregret_trace_file_, 1);
+  WriteMixregretU32(mixregret_trace_file_, 36);
+  WriteMixregretU32(
+      mixregret_trace_file_, 1 + 2 * kMixregretEndpointCount);
+  WriteMixregretU32(mixregret_trace_file_, kMixregretEndpointCount);
+  WriteMixregretU32(mixregret_trace_file_, 0);
+  WriteMixregretU64(mixregret_trace_file_, 0);
+  mixregret_endpoint_p1_.fill(32768);
+}
+
+void Predictor::WriteMixregretTraceRow(int bit) {
+  if (mixregret_trace_file_ == nullptr) return;
+  if (std::fputc(bit, mixregret_trace_file_) == EOF) {
+    std::perror("CMIX_MIXREGRET_TRACE row");
+    std::abort();
+  }
+  for (std::uint16_t p1 : mixregret_endpoint_p1_) {
+    WriteMixregretU16(mixregret_trace_file_, p1);
+  }
+  ++mixregret_trace_rows_;
+}
+
+void Predictor::CloseMixregretTrace() {
+  if (mixregret_trace_file_ == nullptr) return;
+  if (std::fflush(mixregret_trace_file_) != 0 ||
+      std::fseek(mixregret_trace_file_, 28, SEEK_SET) != 0) {
+    std::perror("CMIX_MIXREGRET_TRACE finalize");
+    std::abort();
+  }
+  WriteMixregretU64(mixregret_trace_file_, mixregret_trace_rows_);
+  if (std::fclose(mixregret_trace_file_) != 0) {
+    std::perror("CMIX_MIXREGRET_TRACE close");
+    std::abort();
+  }
+  mixregret_trace_file_ = nullptr;
+}
