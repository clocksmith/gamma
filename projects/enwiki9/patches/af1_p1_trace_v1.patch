 #include "encoder.h"
 
+#ifdef CMIX_AF1_P1_TRACE
+namespace {
+void TraceU16(FILE* file, std::uint16_t value) {
+  const unsigned char bytes[2] = {
+      static_cast<unsigned char>(value),
+      static_cast<unsigned char>(value >> 8)};
+  if (std::fwrite(bytes, 1, sizeof(bytes), file) != sizeof(bytes)) {
+    std::perror("CMIX_AF1_P1_TRACE");
+    std::abort();
+  }
+}
+
+void TraceU32(FILE* file, std::uint32_t value) {
+  unsigned char bytes[4];
+  for (unsigned int i = 0; i < 4; ++i) {
+    bytes[i] = static_cast<unsigned char>(value >> (8 * i));
+  }
+  if (std::fwrite(bytes, 1, sizeof(bytes), file) != sizeof(bytes)) {
+    std::perror("CMIX_AF1_P1_TRACE");
+    std::abort();
+  }
+}
+
+void TraceU64(FILE* file, std::uint64_t value) {
+  unsigned char bytes[8];
+  for (unsigned int i = 0; i < 8; ++i) {
+    bytes[i] = static_cast<unsigned char>(value >> (8 * i));
+  }
+  if (std::fwrite(bytes, 1, sizeof(bytes), file) != sizeof(bytes)) {
+    std::perror("CMIX_AF1_P1_TRACE");
+    std::abort();
+  }
+}
+}  // namespace
+#endif
