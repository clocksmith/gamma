+#ifdef CMIX_AF1_P1_TRACE
+void Encoder::WriteTraceRow(int bit, unsigned int probability) {
+  if (trace_file_ == nullptr) return;
+  if (std::fputc(bit, trace_file_) == EOF) {
+    std::perror("CMIX_AF1_P1_TRACE");
+    std::abort();
+  }
+  TraceU16(trace_file_, static_cast<std::uint16_t>(probability));
+  ++trace_rows_;
+}
+
+void Encoder::CloseTrace() {
+  if (trace_file_ == nullptr) return;
+  if (std::fflush(trace_file_) != 0 ||
+      std::fseek(trace_file_, 24, SEEK_SET) != 0) {
+    std::perror("CMIX_AF1_P1_TRACE");
+    std::abort();
+  }
+  TraceU64(trace_file_, trace_rows_);
+  if (std::fclose(trace_file_) != 0) {
+    std::perror("CMIX_AF1_P1_TRACE");
+    std::abort();
+  }
+  trace_file_ = nullptr;
+}
+#endif
