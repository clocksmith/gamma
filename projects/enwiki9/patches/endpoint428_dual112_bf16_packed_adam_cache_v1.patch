+};
+
+AdamScalars GetAdamScalars(float learning_rate, float t,
+    unsigned long long update_limit) {
+  const float beta1 = 0.025, beta2 = 0.9999;
+  const float effective_t = t < update_limit ? t : update_limit;
+  AdamScalars scalars;
+  scalars.alpha = learning_rate * 0.1f /
