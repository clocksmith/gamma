 #include <numeric>
 
 namespace {
 
+float BFloat16Round(float value) {
+  std::uint32_t bits;
+  std::memcpy(&bits, &value, sizeof(bits));
+  bits += 0x7fffU + ((bits >> 16) & 1U);
+  bits &= 0xffff0000U;
+  std::memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+
+void QuantizeWeights(std::valarray<float>* weights) {
+  for (std::size_t index = 0; index < weights->size(); ++index) {
+    (*weights)[index] = BFloat16Round((*weights)[index]);
+  }
+}
+
+float BFloat16Dot(const std::valarray<float>& input,
+    std::valarray<float>* weights, unsigned int offset, float bias) {
+  const float* input_data = &const_cast<std::valarray<float>&>(input)[0];
+  float* weight_data = &(*weights)[0] + offset;
+  __m512 accum = _mm512_mask_mov_ps(_mm512_setzero_ps(), 1,
+      _mm512_set1_ps(bias));
+  unsigned int index = 0;
+  for (; index + 32 <= input.size(); index += 32) {
+    const __m512 input_low = _mm512_loadu_ps(input_data + index);
+    const __m512 input_high = _mm512_loadu_ps(input_data + index + 16);
+    const __m512 weight_low = _mm512_loadu_ps(weight_data + index);
+    const __m512 weight_high = _mm512_loadu_ps(weight_data + index + 16);
+    const __m512bh packed_input = _mm512_cvtne2ps_pbh(input_high, input_low);
+    const __m512bh packed_weight = _mm512_cvtne2ps_pbh(weight_high, weight_low);
+    accum = _mm512_dpbf16_ps(accum, packed_input, packed_weight);
+  }
+  float result = _mm512_reduce_add_ps(accum);
+  for (; index < input.size(); ++index) {
+    result += BFloat16Round(input_data[index]) * weight_data[index];
+  }
+  return result;
+}
