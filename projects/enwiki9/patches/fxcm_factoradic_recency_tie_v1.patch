+#ifndef CMIX_FXCM_CMC2_FACTORADIC_RECENCY
+#define CMIX_FXCM_CMC2_FACTORADIC_RECENCY 0
+#endif
+
+#if CMIX_FXCM_CMC2_FACTORADIC_RECENCY
+static const U32 fxcmFRTFactorial[11] = {
+  1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880, 3628800
+};
+
+static U32 fxcmFRTRank(const U8 order[10]) {
+  U8 available[10];
+  for (int i=0; i<10; ++i) available[i]=i;
+  int n=10;
+  U32 rank=0;
+  for (int i=0; i<10; ++i) {
+    int digit=0;
+    while (digit<n && available[digit]!=order[i]) ++digit;
+    assert(digit<n);
+    rank+=digit*fxcmFRTFactorial[9-i];
+    for (int j=digit+1; j<n; ++j) available[j-1]=available[j];
+    --n;
+  }
+  return rank;
+}
+
+static void fxcmFRTUnrank(U32 rank, U8 order[10]) {
+  U8 available[10];
+  for (int i=0; i<10; ++i) available[i]=i;
+  int n=10;
+  for (int i=0; i<10; ++i) {
+    const U32 f=fxcmFRTFactorial[9-i];
+    const int digit=rank/f;
+    rank%=f;
+    assert(digit<n);
+    order[i]=available[digit];
+    for (int j=digit+1; j<n; ++j) available[j-1]=available[j];
+    --n;
+  }
+}
+
+static U32 fxcmFRTLoad(const void* cell) {
+  U32 rank=0;
+  memcpy(&rank, (const U8*)cell+92, sizeof(rank));
+  return rank<fxcmFRTFactorial[10] ? rank : 0;
+}
+
+static void fxcmFRTTouch(void* cell, int way) {
+  U8 order[10];
+  fxcmFRTUnrank(fxcmFRTLoad(cell), order);
+  int pos=0;
+  while (pos<10 && order[pos]!=way) ++pos;
+  assert(pos<10);
+  for (int i=pos; i>0; --i) order[i]=order[i-1];
+  order[0]=way;
+  const U32 rank=fxcmFRTRank(order);
+  memcpy((U8*)cell+92, &rank, sizeof(rank));
+}
