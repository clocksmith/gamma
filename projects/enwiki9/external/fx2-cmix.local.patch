+#if FX2_STRUCT_BYTE_PRIOR
+static bool PriorXmlOpen(unsigned int c) {
+  return c == '<'
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'L'
+#endif
+      ;
+}
+
+static bool PriorXmlClose(unsigned int c) {
+  return c == '>'
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'N'
+#endif
+      ;
+}
+
+static bool PriorXmlEq(unsigned int c) {
+  return c == '='
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'M'
+#endif
+      ;
+}
+
+static bool PriorXmlQuestion(unsigned int c) {
+  return c == '?'
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'O'
+#endif
+      ;
+}
+
+static bool PriorXmlColon(unsigned int c) {
+  return c == ':'
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'J'
+#endif
+      ;
+}
+
+static bool PriorXmlSemicolon(unsigned int c) {
+  return c == ';'
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'K'
+#endif
+      ;
+}
+
+static bool PriorWikiOpen(unsigned int c) {
+  return c == '[' || c == '{' || c == '|'
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'P' || c == 'Q'
+#endif
+      ;
+}
+
+static bool PriorWikiClose(unsigned int c) {
+  return c == ']' || c == '}'
+#if FX2_STRUCT_SIDECAR_WRT_AWARE
+      || c == 'R'
+#endif
+      ;
+}
+
+static bool StructuralPriorAllowed(unsigned int c, unsigned long long state,
+    unsigned long long prev) {
+  if (state == 1) {
+    if (PriorXmlOpen(prev)) {
+      return c == '/' || PriorXmlQuestion(c) || c == '!' ||
+          (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
+    }
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+        (c >= '0' && c <= '9') || c == '/' || PriorXmlOpen(c) ||
+        PriorXmlClose(c) || PriorXmlEq(c) || c == '"' || c == '\'' ||
+        c == ' ' || c == '-' || c == '_' || PriorXmlColon(c) ||
+        c == '.' || PriorXmlSemicolon(c) || PriorXmlQuestion(c) ||
+        c == '!' || c == '\n' || c == '\t';
+  }
+  if (state == 2) {
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+        (c >= '0' && c <= '9') || PriorWikiOpen(c) ||
+        PriorWikiClose(c) || PriorXmlEq(c) || c == '_' || c == '-' ||
+        PriorXmlColon(c) || c == '/' || c == '#' || c == ' ' || c == '.' ||
+        c == ',' || c == '\'' || c == '(' || c == ')' || c == '\n';
+  }
+  return true;
+}
+
+float Predictor::StructuralBytePrior() const {
+  const unsigned long long state = manager_.sidecar_lexer_state;
+  if (state == 0) return 0.5f;
+
+  const unsigned int ctx = manager_.bit_context_;
+  unsigned int tmp = ctx;
+  unsigned int prefix_bits = 0;
+  while (tmp > 1) {
+    tmp >>= 1;
+    ++prefix_bits;
+  }
+  if (prefix_bits >= 8) return 0.5f;
+
+  const unsigned int prefix = ctx - (1U << prefix_bits);
+  const unsigned int prefix_shift = 8 - prefix_bits;
+  const unsigned int next_shift = 7 - prefix_bits;
+  unsigned int ones = 0;
+  unsigned int total = 0;
+
+  for (unsigned int c = 0; c < 256; ++c) {
+    if (!vocab_[c]) continue;
+    if (!StructuralPriorAllowed(c, state, manager_.sidecar_prev_byte)) continue;
+    if (prefix_bits > 0 && ((c >> prefix_shift) != prefix)) continue;
+    ++total;
+    ones += (c >> next_shift) & 1U;
+  }
+
+  if (total == 0) return 0.5f;
+  const float raw = static_cast<float>(ones + 1) /
+      static_cast<float>(total + 2);
+  return 0.5f + (raw - 0.5f) *
+      static_cast<float>(FX2_STRUCT_BYTE_PRIOR_STRENGTH);
+}
