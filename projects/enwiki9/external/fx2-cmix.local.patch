+  wrt_observation_in_entity = false;
+  wrt_observation_line_start = true;
+  wrt_observation_heading_equals = 0;
+  wrt_observation_previous = 0;
+  wrt_observation_tag.clear();
+  wrt_observation_tail.clear();
+  wrt_observation_entity.clear();
+}
