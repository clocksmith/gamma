+void LoadWrtObservationDictionary(FILE* dictionary) {
+  wrt_observation_dictionary.clear();
+  if (dictionary == nullptr) return;
+  std::rewind(dictionary);
+  std::string word;
+  for (int value = std::getc(dictionary); value != EOF;
+       value = std::getc(dictionary)) {
+    const unsigned char c = static_cast<unsigned char>(value);
+    if (c >= 'a' && c <= 'z') {
+      word.push_back(static_cast<char>(c));
+    } else if (!word.empty()) {
+      wrt_observation_dictionary.push_back(word);
+      word.clear();
+    }
+  }
+  if (!word.empty()) wrt_observation_dictionary.push_back(word);
+  std::rewind(dictionary);
+}
