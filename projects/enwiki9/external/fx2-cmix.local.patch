+float Predictor::ApplyManifoldOuterSSE(float p) {
+  if (manifold_zero_counts_.empty() || manifold_one_counts_.empty()) {
+    return p;
+  }
+
+  unsigned int p_bucket =
+      static_cast<unsigned int>(p * static_cast<float>(FX2_MANIFOLD_P_BUCKETS));
+  if (p_bucket >= FX2_MANIFOLD_P_BUCKETS) {
+    p_bucket = FX2_MANIFOLD_P_BUCKETS - 1;
+  }
+
+  const unsigned int manifold_bins =
+      FX2_MANIFOLD_SPHERE_BINS * FX2_MANIFOLD_TORUS_BINS;
+  const unsigned int bit_pos = manager_.bpos & 7u;
+  const unsigned int key =
+      ((p_bucket * 8u + bit_pos) * manifold_bins) + ManifoldBucket();
+  manifold_last_key_ = key;
+  manifold_has_last_key_ = key < manifold_zero_counts_.size();
+  if (!manifold_has_last_key_) {
+    return p;
+  }
+
+  const unsigned int zeros = manifold_zero_counts_[key];
+  const unsigned int ones = manifold_one_counts_[key];
+  const unsigned int total = zeros + ones;
+  unsigned int base_p1 = static_cast<unsigned int>(p * 65536.0f);
+  if (base_p1 < 1u) base_p1 = 1u;
+  if (base_p1 > 65535u) base_p1 = 65535u;
+#if FX2_MANIFOLD_CORRECTION_BIAS
+  manifold_last_p1_ = base_p1;
+  float table_p = static_cast<float>(base_p1) / 65536.0f;
+  if (total > 0) {
+    const float mean_delta =
+        static_cast<float>(manifold_residual_sums_[key]) /
+        static_cast<float>(total);
+    float corrected_p1 = static_cast<float>(base_p1) + mean_delta *
+        (static_cast<float>(FX2_MANIFOLD_BLEND_PPM) / 1000000.0f);
+    if (corrected_p1 < 1.0f) corrected_p1 = 1.0f;
+    if (corrected_p1 > 65535.0f) corrected_p1 = 65535.0f;
+    table_p = corrected_p1 / 65536.0f;
+  }
+  p = table_p;
+#else
+  const unsigned long long numerator =
+      (static_cast<unsigned long long>(2u * ones + 1u) << 16);
+  const unsigned long long denominator =
+      static_cast<unsigned long long>(2u * (total + 1u));
+  const float table_p =
+      static_cast<float>(numerator / denominator) / 65536.0f;
+  unsigned int blend_ppm = FX2_MANIFOLD_BLEND_PPM;
+  if (blend_ppm > 1000000u) blend_ppm = 1000000u;
+  p += (table_p - p) * (static_cast<float>(blend_ppm) / 1000000.0f);
+#endif
+  if (p < (1.0f / 65536.0f)) return 1.0f / 65536.0f;
+  if (p > (65535.0f / 65536.0f)) return 65535.0f / 65536.0f;
+  return p;
+}
+
+void Predictor::UpdateManifoldOuterSSE(int bit) {
+  if (!manifold_has_last_key_ ||
+      manifold_last_key_ >= manifold_zero_counts_.size()) {
+    return;
+  }
+  unsigned short& count = bit ? manifold_one_counts_[manifold_last_key_]
+                              : manifold_zero_counts_[manifold_last_key_];
+  if (count < 65535) ++count;
+#if FX2_MANIFOLD_CORRECTION_BIAS
+  if (bit) {
+    manifold_residual_sums_[manifold_last_key_] +=
+        static_cast<int>(65536u - manifold_last_p1_);
+  } else {
+    manifold_residual_sums_[manifold_last_key_] -=
+        static_cast<int>(manifold_last_p1_);
+  }
+#endif
+}
