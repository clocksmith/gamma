+  const unsigned int off = side_tail_len - n;
+  for (unsigned int i = 0; i < n; ++i) {
+    if (side_tail_[off + i] != static_cast<unsigned char>(s[i])) return false;
+  }
+  return true;
+}
+
+bool ContextManager::SidecarEndsWithFold(const char* s) const {
+  const unsigned int n = std::strlen(s);
+  if (n > side_tail_len) return false;
+  const unsigned int off = side_tail_len - n;
+  for (unsigned int i = 0; i < n; ++i) {
+    if (SideLower(side_tail_[off + i]) !=
+        SideLower(static_cast<unsigned char>(s[i]))) return false;
+  }
+  return true;
