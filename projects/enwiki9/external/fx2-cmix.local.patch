+float Predictor::StructuralBytePrior() const {
+  const unsigned long long state = manager_.sidecar_lexer_state;
+  if (state == 0) return 0.5f;
+
+  const unsigned int ctx = manager_.bit_context_;
+  unsigned int tmp = ctx;
+  unsigned int prefix_bits = 0;
+  while (tmp > 1) {
+    tmp >>= 1;
+    ++prefix_bits;
+  }
+  if (prefix_bits >= 8) return 0.5f;
+
+  const unsigned int prefix = ctx - (1U << prefix_bits);
+  const unsigned int prefix_shift = 8 - prefix_bits;
+  const unsigned int next_shift = 7 - prefix_bits;
+  unsigned int ones = 0;
+  unsigned int total = 0;
+
+  for (unsigned int c = 0; c < 256; ++c) {
+    if (!vocab_[c]) continue;
+    if (!StructuralPriorAllowed(c, state, manager_.sidecar_prev_byte)) continue;
+    if (prefix_bits > 0 && ((c >> prefix_shift) != prefix)) continue;
+    ++total;
+    ones += (c >> next_shift) & 1U;
+  }
+
+  if (total == 0) return 0.5f;
+  const float raw = static_cast<float>(ones + 1) /
+      static_cast<float>(total + 2);
+  return 0.5f + (raw - 0.5f) *
+      static_cast<float>(FX2_STRUCT_BYTE_PRIOR_STRENGTH);
+}
