{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-midpoint-persistence-attribution-verification.v2",
  "title": "CMIX midpoint persistence attribution independent verification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "candidate_id", "verified", "errors", "receipt_sha256",
    "evidence_sha256", "computed", "decision", "successor_activation_authority",
    "compression_credit_bytes", "score_credit_bytes"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-midpoint-persistence-attribution-verification.v2"},
    "candidate_id": {"const": "cmix_obias_midpoint_persistence_attribution64_q0_v2"},
    "verified": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_sha256": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "computed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "F_gain_bytes", "J_gain_bytes", "S_gain_bytes", "F_beats_S_pass",
        "retention_numerator_bytes", "retention_denominator_bytes",
        "fork_retention_pass", "exactness_pass", "rejoin_pass", "resources_pass"
      ],
      "properties": {
        "F_gain_bytes": {"type": "integer"},
        "J_gain_bytes": {"type": "integer"},
        "S_gain_bytes": {"type": "integer"},
        "F_beats_S_pass": {"type": "boolean"},
        "retention_numerator_bytes": {"type": "integer"},
        "retention_denominator_bytes": {"type": "integer"},
        "fork_retention_pass": {"type": "boolean"},
        "exactness_pass": {"type": "boolean"},
        "rejoin_pass": {"type": "boolean"},
        "resources_pass": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_classification", "scientific_verdict", "authorized_successor"],
      "properties": {
        "terminal_classification": {"type": "string", "minLength": 1},
        "scientific_verdict": {"enum": ["pass", "fail", "none", "invalid"]},
        "authorized_successor": {"type": "string", "minLength": 1}
      }
    },
    "successor_activation_authority": {"type": "boolean"},
    "compression_credit_bytes": {"const": 0},
    "score_credit_bytes": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
