{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.dev/enwiki9/research/v1/clean-room-replay.schema.json",
  "title": "gamma.enwiki9.clean_room_replay.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "candidateId",
    "candidateTreeSha256",
    "sandbox",
    "probe",
    "executions",
    "packageCopiesVerified",
    "decodeCorpusExposed",
    "scratchCleaned",
    "licenseAudit",
    "allCommandsSucceeded",
    "generatedUtc"
  ],
  "properties": {
    "schema": { "const": "gamma.enwiki9.clean-room-replay.v1" },
    "objective": { "$ref": "#/$defs/objectiveBinding" },
    "candidateId": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "candidateTreeSha256": { "$ref": "#/$defs/digest" },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "allNamespacesUnshared",
        "networkNamespaceUnshared",
        "newSession",
        "clearEnvironment",
        "minimalDeviceFilesystem",
        "readOnlySystemRoots",
        "writableRoots",
        "environment",
        "hostDataPathsVisible"
      ],
      "properties": {
        "implementation": { "const": "bubblewrap" },
        "version": { "type": "string", "minLength": 1 },
        "allNamespacesUnshared": { "const": true },
        "networkNamespaceUnshared": { "const": true },
        "newSession": { "const": true },
        "clearEnvironment": { "const": true },
        "minimalDeviceFilesystem": { "const": true },
        "readOnlySystemRoots": {
          "type": "array",
          "const": ["/usr"]
        },
        "writableRoots": {
          "type": "array",
          "const": ["/dev", "/tmp", "/work"]
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["LC_ALL", "PATH", "SOURCE_DATE_EPOCH", "TZ"],
          "properties": {
            "LC_ALL": { "const": "C" },
            "PATH": { "const": "/usr/bin:/bin" },
            "SOURCE_DATE_EPOCH": { "const": "0" },
            "TZ": { "const": "UTC" }
          }
        },
        "hostDataPathsVisible": { "const": false }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceCommand", "deviceReturncode", "devicePaths", "networkCommand", "networkReturncode", "networkInterfaces"],
      "properties": {
        "deviceCommand": { "$ref": "#/$defs/command" },
        "deviceReturncode": { "const": 0 },
        "devicePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/dev(?:/.*)?$" }
        },
        "networkCommand": { "$ref": "#/$defs/command" },
        "networkReturncode": { "const": 0 },
        "networkInterfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "executions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "command", "returncode", "guard", "log"],
        "properties": {
          "phase": {
            "enum": ["build-first", "compression", "build-replay", "compression-replay", "build-decode", "decompression"]
          },
          "command": { "$ref": "#/$defs/command" },
          "returncode": { "type": "integer" },
          "guard": {
            "oneOf": [
              { "$ref": "#/$defs/reference" },
              { "type": "null" }
            ]
          },
          "log": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "packageCopiesVerified": { "const": 3 },
    "decodeCorpusExposed": { "const": false },
    "scratchCleaned": { "type": "boolean" },
    "licenseAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "licenseFiles", "dependencyLicenses", "issues"],
      "properties": {
        "approved": { "type": "boolean" },
        "licenseFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencyLicenses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allCommandsSucceeded": { "type": "boolean" },
    "generatedUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "objectiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectiveId", "objectiveDigest", "objectivePath", "targetScoreBytes", "corpusBytes", "corpusSha256"],
      "properties": {
        "objectiveId": { "type": "string", "minLength": 1 },
        "objectiveDigest": { "$ref": "#/$defs/digest" },
        "objectivePath": { "type": "string", "minLength": 1 },
        "targetScoreBytes": { "type": "integer", "minimum": 1 },
        "corpusBytes": { "type": "integer", "minimum": 1 },
        "corpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
