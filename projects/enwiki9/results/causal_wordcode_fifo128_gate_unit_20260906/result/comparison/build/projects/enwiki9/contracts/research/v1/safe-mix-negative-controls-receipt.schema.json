{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.safe-mix-negative-controls-receipt.v1",
  "title": "SAFE-MIX transactional negative-controls receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "probability_scale", "controls", "pending_state_digest_pass", "identity_control_pass", "all_controls_pass", "execution_authority", "archive_authority", "score_credit_bytes"],
  "properties": {
    "schema": {"const": "gamma.enwiki9.safe-mix-negative-controls-receipt.v1"},
    "candidate_id": {"const": "gamma_safe_mix_v1"},
    "probability_scale": {"const": 4096},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalid_initialization", "repeated_reset", "nested_mix", "observe_without_mix", "mismatched_observe", "null_output", "invalid_parent_count", "invalid_treatment_count"],
      "properties": {
        "invalid_initialization": {"const": true},
        "repeated_reset": {"const": true},
        "nested_mix": {"const": true},
        "observe_without_mix": {"const": true},
        "mismatched_observe": {"const": true},
        "null_output": {"const": true},
        "invalid_parent_count": {"const": true},
        "invalid_treatment_count": {"const": true}
      }
    },
    "pending_state_digest_pass": {"const": true},
    "identity_control_pass": {"const": true},
    "all_controls_pass": {"const": true},
    "execution_authority": {"const": false},
    "archive_authority": {"const": false},
    "score_credit_bytes": {"const": 0}
  }
}
