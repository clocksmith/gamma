        "python_source_closure": {"$ref": "#/$defs/artifact"},
        "observer_build": {"$ref": "#/$defs/artifact"},
        "observer_build_schema": {"$ref": "#/$defs/artifact"},
        "opening_distant_10m_receipt": {"$ref": "#/$defs/artifact"},
        "opening_distant_10m_verification": {"$ref": "#/$defs/artifact"}
      }
    },
    "fixed_scopes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
