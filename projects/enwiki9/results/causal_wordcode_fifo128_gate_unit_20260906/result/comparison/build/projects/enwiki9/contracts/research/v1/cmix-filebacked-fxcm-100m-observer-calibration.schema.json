  "properties": {
    "schema": {
      "const": "gamma.enwiki9.cmix-filebacked-fxcm-100m-observer-calibration.v1"
    },
    "candidate_id": {
      "const": "cmix_obias_memory_safe_parent_filebacked_q1_v1"
    },
    "antecedents": {
      "type": "object",
      "additionalProperties": false,
