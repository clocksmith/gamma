{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-100m-observer-calibration.v1",
  "title": "CMIX q1 100M observer opening/distant 10M calibration receipt",
  "type": "object",
  "additionalProperties": false,
