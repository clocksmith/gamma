  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableArtifact": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/artifact"}
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "offset",
        "bytes",
        "slice_sha256",
        "probability_tap",
        "package",
        "reference_payload",
        "encode_return_code",
        "encode_guard",
        "encode_guard_pass",
        "probability_sha256",
        "probability_summary",
        "coder_checkpoints",
        "persistent_state",
        "transformed_input",
        "arithmetic_payload",
        "self_extracting_archive",
        "payload_reference_identity_pass",
        "observer_geometry_pass",
        "decode_required",
        "decode_return_code",
        "decode_guard",
        "decode_guard_pass",
        "decoded_transformed",
        "raw_inverse",
        "transformed_inverse_pass",
        "raw_inverse_pass",
        "backing_cleanup_pass"
      ],
      "properties": {
        "arm": {"enum": ["I-P", "I-Q", "N-P"]},
        "offset": {"enum": [0, 500000000]},
        "bytes": {"const": 10000000},
        "slice_sha256": {"$ref": "#/$defs/sha256"},
        "probability_tap": {"enum": ["post_head", "pre_head"]},
        "package": {"$ref": "#/$defs/artifact"},
        "reference_payload": {"$ref": "#/$defs/artifact"},
        "encode_return_code": {"type": "integer"},
        "encode_guard": {"$ref": "#/$defs/artifact"},
        "encode_guard_pass": {"type": "boolean"},
        "probability_sha256": {"$ref": "#/$defs/sha256"},
        "probability_summary": {"$ref": "#/$defs/artifact"},
        "coder_checkpoints": {"$ref": "#/$defs/artifact"},
        "persistent_state": {"$ref": "#/$defs/artifact"},
        "transformed_input": {"$ref": "#/$defs/artifact"},
        "arithmetic_payload": {"$ref": "#/$defs/artifact"},
        "self_extracting_archive": {"$ref": "#/$defs/artifact"},
        "payload_reference_identity_pass": {"type": "boolean"},
        "observer_geometry_pass": {"type": "boolean"},
        "decode_required": {"type": "boolean"},
        "decode_return_code": {"type": ["integer", "null"]},
        "decode_guard": {"$ref": "#/$defs/nullableArtifact"},
        "decode_guard_pass": {"type": ["boolean", "null"]},
        "decoded_transformed": {"$ref": "#/$defs/nullableArtifact"},
        "raw_inverse": {"$ref": "#/$defs/nullableArtifact"},
        "transformed_inverse_pass": {"type": ["boolean", "null"]},
        "raw_inverse_pass": {"type": ["boolean", "null"]},
        "backing_cleanup_pass": {"type": "boolean"}
      }
    }
  }
}
