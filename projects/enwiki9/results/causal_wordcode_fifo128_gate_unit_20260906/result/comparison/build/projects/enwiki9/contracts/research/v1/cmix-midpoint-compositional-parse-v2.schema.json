          "updates": {
            "properties": {
              "first_record": {"$ref": "#/$defs/fUpdateEdge"},
              "last_record": {"$ref": "#/$defs/fUpdateEdge"},
              "all_k_dynamic_equal": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"run": {"properties": {"arm": {"const": "S"}}, "required": ["arm"]}},
        "required": ["run"]
