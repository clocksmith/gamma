            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"run": {"properties": {"arm": {"const": "F"}}, "required": ["arm"]}},
        "required": ["run"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "update_records": {"minimum": 1},
              "committed_update_records": {"minimum": 1},
              "detached_update_records": {"const": 0},
              "k_dynamic_equal_records": {"const": 0}
