        "unattributed_codec_rss_upper_bound_kib": {
          "type": "integer",
          "minimum": 0
        },
        "continuous_peak_ownership_claimed": {
          "const": false
        }
      }
    },
    "allocation_ranges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allocation_range"
      }
    },
    "source_labels": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/source_label"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "label": {
                "const": "fxcm_alloc"
              }
            },
            "required": [
              "label"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "label": {
                "const": "fxcm_aligned_alloc"
              }
            },
            "required": [
              "label"
