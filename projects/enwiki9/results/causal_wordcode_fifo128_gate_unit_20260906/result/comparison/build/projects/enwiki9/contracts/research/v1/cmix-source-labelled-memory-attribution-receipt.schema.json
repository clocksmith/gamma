        {
          "contains": {
            "properties": {
              "label": {
                "const": "context_indirect_2"
              }
            },
            "required": [
              "label"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "label": {
                "const": "context_indirect_3"
              }
            },
            "required": [
              "label"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "label": {
                "const": "mixer_slab"
              }
            },
            "required": [
              "label"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "label": {
                "const": "ppm_anonymous_arena"
              }
            },
            "required": [
              "label"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "label": {
                "const": "ppm_file_backed_arena"
              }
            },
            "required": [
              "label"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "invalidity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalid",
        "reason_codes"
      ],
      "properties": {
        "invalid": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "memory_eligibility_proved",
        "successor_authorized",
        "eligible_reclaimable_kib",
        "required_reduction_kib",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "enum": [
            "attributed",
            "insufficient_attribution",
            "invalid"
          ]
        },
        "memory_eligibility_proved": {
          "const": false
        },
        "successor_authorized": {
          "enum": [
            null,
            "cmix_obias_filebacked_fxcm_allocator_strategy_q0_v1"
          ]
        },
        "eligible_reclaimable_kib": {
          "type": "integer",
          "minimum": 0
        },
        "required_reduction_kib": {
          "const": 1472880
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    }
