        "sample_stream_sha256",
        "pagemap_range_manifest_sha256",
        "managed_lease_transition_log_sha256",
        "managed_lease_verification_sha256",
        "managed_lease_verification_pass",
        "terminal_managed_lease_sha256"
      ],
      "properties": {
        "allocation_marker_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "phase_attribution_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resource_guard_v3_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_integration_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_stream_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pagemap_range_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "managed_lease_transition_log_sha256": {
          "$ref": "#/$defs/sha256"
