  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "source_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "allocation_count",
        "live_at_high_water_count",
        "resident_lower_bound_at_checkpoint_kib",
        "resident_upper_bound_at_checkpoint_kib",
        "fully_contained_pages",
        "allocation_bytes",
        "conservative_range_bound_valid",
        "eligible_for_memory_successor"
      ],
      "properties": {
        "label": {
          "enum": [
            "fxcm_alloc",
            "fxcm_aligned_alloc",
            "context_history",
            "context_shared_map",
            "context_indirect_1",
            "context_indirect_2",
            "context_indirect_3",
            "mixer_slab",
            "ppm_anonymous_arena",
            "ppm_file_backed_arena"
          ]
        },
        "allocation_count": {
          "type": "integer",
          "minimum": 0
        },
        "live_at_high_water_count": {
          "type": "integer",
          "minimum": 0
        },
        "resident_lower_bound_at_checkpoint_kib": {
          "type": "integer",
          "minimum": 0
        },
        "resident_upper_bound_at_checkpoint_kib": {
          "type": "integer",
          "minimum": 0
        },
        "fully_contained_pages": {
          "type": "integer",
          "minimum": 0
        },
        "allocation_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "conservative_range_bound_valid": {
          "type": "boolean"
        },
        "eligible_for_memory_successor": {
          "type": "boolean"
        },
        "not_allocated_reason": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allocation_count": {
                "const": 0
              }
            }
          },
          "then": {
            "required": [
              "not_allocated_reason"
            ]
          }
        }
      ]
    },
    "allocation_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_sequence",
        "label",
        "allocation_base",
        "usable_pointer",
        "allocation_bytes",
        "usable_bytes",
        "first_fully_contained_page",
        "fully_contained_pages",
        "present_read_one_pages",
        "present_read_two_pages",
        "present_intersection_pages",
        "present_union_pages",
        "resident_lower_bound_kib",
        "resident_upper_bound_kib",
        "live_at_checkpoint",
        "vma_containment_pass",
        "marker_window_exact",
        "conservative_range_bound_valid",
        "eligible_for_memory_successor"
