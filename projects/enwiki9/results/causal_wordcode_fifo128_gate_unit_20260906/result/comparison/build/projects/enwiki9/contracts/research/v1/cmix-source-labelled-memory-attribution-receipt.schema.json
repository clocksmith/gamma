        "label": {
          "$ref": "#/$defs/allocation_label"
        },
        "allocation_base": {
          "type": "integer",
          "minimum": 1
        },
        "usable_pointer": {
          "type": "integer",
          "minimum": 1
        },
        "allocation_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "usable_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "first_fully_contained_page": {
          "type": "integer",
          "minimum": 0
        },
        "fully_contained_pages": {
          "type": "integer",
          "minimum": 0
        },
        "present_read_one_pages": {
          "type": "integer",
          "minimum": 0
        },
        "present_read_two_pages": {
          "type": "integer",
          "minimum": 0
        },
        "present_intersection_pages": {
          "type": "integer",
          "minimum": 0
        },
        "present_union_pages": {
          "type": "integer",
          "minimum": 0
        },
        "resident_lower_bound_kib": {
          "type": "integer",
          "minimum": 0
        },
        "resident_upper_bound_kib": {
          "type": "integer",
          "minimum": 0
        },
        "live_at_checkpoint": {
          "type": "boolean"
        },
        "vma_containment_pass": {
          "type": "boolean"
        },
        "marker_window_exact": {
          "type": "boolean"
        },
        "conservative_range_bound_valid": {
          "type": "boolean"
        },
        "eligible_for_memory_successor": {
          "type": "boolean"
        }
      }
    },
    "allocation_label": {
      "enum": [
        "fxcm_alloc",
        "fxcm_aligned_alloc",
        "context_history",
        "context_shared_map",
        "context_indirect_1",
        "context_indirect_2",
        "context_indirect_3",
        "mixer_slab",
        "ppm_anonymous_arena",
        "ppm_file_backed_arena"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "successor_authorized": {
                "const": "cmix_obias_filebacked_fxcm_allocator_strategy_q0_v1"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "managed_lease_verification_pass": {
                "const": true
              }
            }
          },
          "sequence": {
            "properties": {
              "contiguous": {
                "const": true
              },
              "registry_healthy": {
                "const": true
              },
              "unmatched_releases": {
                "const": 0
              }
            }
          },
          "high_water": {
            "properties": {
              "process_tree_stopped": {
                "const": true
              },
              "marker_window_exact": {
                "const": true
              },
              "pagemap_permission_pass": {
                "const": true
              },
              "smaps_reconciled": {
                "const": true
              },
              "coherent_checkpoint": {
                "const": true
              }
            }
          },
          "source_labels": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "label": {
                      "const": "fxcm_alloc"
                    },
                    "conservative_range_bound_valid": {
                      "const": true
                    },
                    "eligible_for_memory_successor": {
                      "const": true
                    }
                  },
                  "required": [
                    "label",
                    "conservative_range_bound_valid",
                    "eligible_for_memory_successor"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "label": {
                      "const": "fxcm_aligned_alloc"
                    },
                    "conservative_range_bound_valid": {
                      "const": true
                    },
                    "eligible_for_memory_successor": {
                      "const": true
                    }
                  },
                  "required": [
                    "label",
                    "conservative_range_bound_valid",
