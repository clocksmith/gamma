        },
        "terminal_managed_lease_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "first_sequence",
        "last_sequence",
        "contiguous",
        "registry_healthy",
