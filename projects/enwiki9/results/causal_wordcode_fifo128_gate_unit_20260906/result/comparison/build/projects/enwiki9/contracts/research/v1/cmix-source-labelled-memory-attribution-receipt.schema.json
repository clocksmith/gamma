{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.local/contracts/research/v1/cmix-source-labelled-memory-attribution-receipt.schema.json",
  "title": "CMIX Source-Labelled Memory Attribution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "created_utc",
    "identity",
    "evidence",
    "sequence",
    "high_water",
    "allocation_ranges",
    "source_labels",
    "invalidity",
