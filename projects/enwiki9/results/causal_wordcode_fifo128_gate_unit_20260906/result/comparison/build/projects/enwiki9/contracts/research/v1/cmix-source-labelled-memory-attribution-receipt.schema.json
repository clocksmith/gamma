        "phase": {
          "$ref": "#/$defs/nonempty"
        },
        "continuous_process_tree_peak_kib": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_process_tree_rss_kib": {
          "type": "integer",
          "minimum": 0
        },
        "codec_rss_kib": {
          "type": "integer",
          "minimum": 0
