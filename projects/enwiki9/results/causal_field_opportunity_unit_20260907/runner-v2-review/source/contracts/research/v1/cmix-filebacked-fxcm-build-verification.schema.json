{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-build-verification.v1",
  "title": "CMIX file-backed FXCM independent build verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "build_role",
    "build_a_receipt_sha256",
    "build_b_receipt_sha256",
    "build_a_binary_sha256",
    "build_b_binary_sha256",
    "shared_allocator_header_sha256",
    "source_closure_sha256",
    "capture_tool_sha256",
    "compiler_proxy_sha256",
    "command_manifest_sha256",
    "stage_executable_manifest_sha256",
    "compiler_invocation_manifest_sha256",
    "compiler_invocation_count",
    "compiler_binary_sha256",
    "linker_binary_sha256",
    "build_id_distinct_pass",
    "build_root_identity_distinct_pass",
    "source_closure_identity_pass",
    "toolchain_identity_pass",
    "command_identity_pass",
    "environment_identity_pass",
    "shared_allocator_identity_pass",
    "macro_boundary_pass",
    "compiler_invocation_identity_pass",
    "binary_identity_pass",
    "independent_build_pass",
    "authority",
    "execution_authority"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-filebacked-fxcm-build-verification.v1"},
    "candidate_id": {"const": "cmix_obias_memory_safe_parent_filebacked_q1_v1"},
    "build_role": {"enum": ["release", "harness"]},
    "build_a_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "build_b_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "build_a_binary_sha256": {"$ref": "#/$defs/sha256"},
    "build_b_binary_sha256": {"$ref": "#/$defs/sha256"},
    "shared_allocator_header_sha256": {"$ref": "#/$defs/sha256"},
    "source_closure_sha256": {"$ref": "#/$defs/sha256"},
    "capture_tool_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_proxy_sha256": {"$ref": "#/$defs/sha256"},
    "command_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "stage_executable_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_invocation_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_invocation_count": {"type": "integer", "minimum": 1},
    "compiler_binary_sha256": {"$ref": "#/$defs/sha256"},
    "linker_binary_sha256": {"$ref": "#/$defs/sha256"},
    "build_id_distinct_pass": {"const": true},
    "build_root_identity_distinct_pass": {"const": true},
    "source_closure_identity_pass": {"const": true},
    "toolchain_identity_pass": {"const": true},
    "command_identity_pass": {"const": true},
    "environment_identity_pass": {"const": true},
    "shared_allocator_identity_pass": {"const": true},
    "macro_boundary_pass": {"const": true},
    "compiler_invocation_identity_pass": {"const": true},
    "binary_identity_pass": {"const": true},
    "independent_build_pass": {"const": true},
    "authority": {"const": "build_identity_only"},
    "execution_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
