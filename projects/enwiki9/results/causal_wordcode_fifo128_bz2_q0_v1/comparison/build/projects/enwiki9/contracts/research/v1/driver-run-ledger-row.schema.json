{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.dev/enwiki9/research/v1/driver-run-ledger-row.schema.json",
  "title": "gamma.enwiki9.driver-run-ledger-row.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "program_id", "candidate_revision", "algorithm_name",
    "data_path", "data_size", "data_md5", "data_sha256", "compressed_md5",
    "compressed_sha256", "compressed_size", "program_size", "hutter_score",
    "bits_per_byte", "compress_time_s", "decompress_time_s", "run_time_s",
    "run_purpose", "run_scope_label", "run_context", "run_source", "run_tags",
    "determinism_ok", "roundtrip_ok", "result_path", "result_bytes",
    "result_sha256", "archival_scope", "timestamp", "recorded_utc", "host",
    "memory_kib_before", "memory_kib_after", "memory_kib_peak", "rss_sample_count"
  ],
  "properties": {
    "schema": { "const": "gamma.enwiki9.driver-run-ledger-row.v2" },
    "run_id": { "type": "string", "minLength": 1 },
    "program_id": { "type": "string", "minLength": 1 },
    "candidate_revision": { "type": ["object", "null"] },
    "algorithm_name": { "type": "string", "minLength": 1 },
    "data_path": { "type": ["string", "null"] },
    "data_size": { "type": ["integer", "null"], "minimum": 0 },
    "data_md5": { "$ref": "#/$defs/nullableMd5" },
    "data_sha256": { "$ref": "#/$defs/nullableSha256" },
    "compressed_md5": { "$ref": "#/$defs/nullableMd5" },
    "compressed_sha256": { "$ref": "#/$defs/nullableSha256" },
    "compressed_size": { "type": ["integer", "null"], "minimum": 0 },
    "program_size": { "type": ["integer", "null"], "minimum": 0 },
    "hutter_score": { "type": ["integer", "number", "null"], "minimum": 0 },
    "bits_per_byte": { "type": ["number", "null"], "minimum": 0 },
    "compress_time_s": { "$ref": "#/$defs/nullableDuration" },
    "decompress_time_s": { "$ref": "#/$defs/nullableDuration" },
    "run_time_s": { "$ref": "#/$defs/nullableDuration" },
    "run_purpose": { "type": "string", "minLength": 1 },
    "run_scope_label": { "type": "string", "minLength": 1 },
    "run_context": { "type": ["string", "null"] },
    "run_source": { "type": ["string", "null"] },
    "run_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "determinism_ok": { "type": ["boolean", "null"] },
    "roundtrip_ok": { "type": ["boolean", "null"] },
    "result_path": { "$ref": "#/$defs/relativePath" },
    "result_bytes": { "type": "integer", "minimum": 1 },
    "result_sha256": { "$ref": "#/$defs/sha256" },
    "archival_scope": { "const": "full" },
    "timestamp": { "type": "string", "minLength": 1 },
    "recorded_utc": { "type": "string", "format": "date-time" },
    "host": { "type": ["object", "null"] },
    "memory_kib_before": { "type": ["integer", "null"], "minimum": 0 },
    "memory_kib_after": { "type": ["integer", "null"], "minimum": 0 },
    "memory_kib_peak": { "type": ["integer", "null"], "minimum": 0 },
    "rss_sample_count": { "type": ["integer", "null"], "minimum": 0 }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableMd5": { "oneOf": [{ "$ref": "#/$defs/md5" }, { "type": "null" }] },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "nullableDuration": { "type": ["number", "null"], "minimum": 0 }
  }
}
