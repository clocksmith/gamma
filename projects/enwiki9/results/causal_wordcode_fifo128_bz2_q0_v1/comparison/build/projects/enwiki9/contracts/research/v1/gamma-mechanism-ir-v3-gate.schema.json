{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.gamma-mechanism-ir-v3-gate.v1",
  "title": "Gamma Mechanism IR v3 static gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "program_id",
    "verified",
    "errors",
    "program_lock",
    "program_lock_verification",
    "compilation_verification",
    "checks",
    "claim_authority",
    "execution_authority",
    "promotion_authority"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.gamma-mechanism-ir-v3-gate.v1"},
    "program_id": {"const": "gamma_mechanism_ir_v3"},
    "verified": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "program_lock": {"$ref": "#/$defs/file"},
    "program_lock_verification": {"$ref": "#/$defs/file"},
    "compilation_verification": {"$ref": "#/$defs/file"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_lock_verification_pass",
        "compilation_verification_pass",
        "locked_compiler_identity_pass",
        "locked_ir_identity_pass",
        "locked_closure_identity_pass",
        "required_program_closure_pass"
      ],
      "properties": {
        "program_lock_verification_pass": {"type": "boolean"},
        "compilation_verification_pass": {"type": "boolean"},
        "locked_compiler_identity_pass": {"type": "boolean"},
        "locked_ir_identity_pass": {"type": "boolean"},
        "locked_closure_identity_pass": {"type": "boolean"},
        "required_program_closure_pass": {"type": "boolean"}
      }
    },
    "claim_authority": {"const": "none"},
    "execution_authority": {"const": false},
    "promotion_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
