{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-compiler-invocation.v1",
  "title": "CMIX file-backed FXCM compiler invocation trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "sequence", "build_role", "proxy_sha256", "python_executable_sha256", "compiler_sha256", "linker_sha256", "cwd", "argv", "definitions", "compile_event", "response_file_absent_pass", "return_code"],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-filebacked-fxcm-compiler-invocation.v1"},
    "candidate_id": {"const": "cmix_obias_memory_safe_parent_filebacked_q1_v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "build_role": {"enum": ["release", "harness"]},
    "proxy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "python_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "linker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cwd": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "definitions": {"type": "array", "items": {"type": "string", "pattern": "^-D.+"}},
    "compile_event": {"type": "boolean"},
    "response_file_absent_pass": {"type": "boolean"},
    "return_code": {"type": "integer"}
  }
}
