{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-midpoint-persistence-attribution-receipt.v2",
  "title": "CMIX midpoint persistence attribution receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "candidate_id", "evidence", "scope", "arms",
    "rejoin", "resources", "reported", "decision", "authority"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-midpoint-persistence-attribution-receipt.v2"},
    "receipt_id": {"type": "string", "minLength": 1},
    "candidate_id": {"const": "cmix_obias_midpoint_persistence_attribution64_q0_v2"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_contract", "experiment_contract", "receipt_schema", "verifier",
        "q1_policy", "q1_qualification_verification", "oracle_contract",
        "oracle_authority_verification", "source_tree_manifest", "build_receipt",
        "binary", "population_manifest", "package_manifest"
      ],
      "properties": {
        "planning_contract": {"$ref": "#/$defs/file"},
        "experiment_contract": {"$ref": "#/$defs/file"},
        "receipt_schema": {"$ref": "#/$defs/file"},
        "verifier": {"$ref": "#/$defs/file"},
        "q1_policy": {"$ref": "#/$defs/file"},
        "q1_qualification_verification": {"$ref": "#/$defs/file"},
        "oracle_contract": {"$ref": "#/$defs/file"},
        "oracle_authority_verification": {"$ref": "#/$defs/file"},
        "source_tree_manifest": {"$ref": "#/$defs/file"},
        "build_receipt": {"$ref": "#/$defs/file"},
        "binary": {"$ref": "#/$defs/file"},
        "population_manifest": {"$ref": "#/$defs/file"},
        "package_manifest": {"$ref": "#/$defs/file"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_bytes", "segment_bytes", "midpoint_byte", "complete_population_pass", "required_F_gain_bytes"],
      "properties": {
        "raw_bytes": {"enum": [250000, 1000000, 10000000]},
        "segment_bytes": {"const": 64},
        "midpoint_byte": {"const": 32},
        "complete_population_pass": {"type": "boolean"},
        "required_F_gain_bytes": {"enum": [0, 4080, 40793]}
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P", "F", "J", "S"],
      "properties": {
        "P": {"allOf": [{"$ref": "#/$defs/arm"}, {"properties": {"arm": {"const": "P"}}}]},
        "F": {"allOf": [{"$ref": "#/$defs/arm"}, {"properties": {"arm": {"const": "F"}}}]},
        "J": {"allOf": [{"$ref": "#/$defs/arm"}, {"properties": {"arm": {"const": "J"}}}]},
        "S": {"allOf": [{"$ref": "#/$defs/arm"}, {"properties": {"arm": {"const": "S"}}}]}
      }
    },
    "rejoin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_access_manifest_sha256", "arm_difference_manifest_sha256", "join_count",
        "P_join_state_stream_sha256", "J_parent_join_state_stream_sha256",
        "F_adapted_second_half_stream_sha256", "J_adapted_second_half_stream_sha256",
        "coder_continuity_stream_sha256", "P_J_parent_branch_identity_pass",
        "F_J_adapted_trajectory_identity_pass", "identical_truth_stream_pass",
        "parent_native_cadence_pass", "coder_not_forked_or_rewound_pass",
        "truth_only_shared_state_audit_pass", "no_writable_alias_pass",
        "no_adapted_persistent_write_survived_pass", "live_negative_mutation_control_pass"
      ],
      "properties": {
        "state_access_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "arm_difference_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "join_count": {"type": "integer", "minimum": 1},
        "P_join_state_stream_sha256": {"$ref": "#/$defs/sha256"},
        "J_parent_join_state_stream_sha256": {"$ref": "#/$defs/sha256"},
        "F_adapted_second_half_stream_sha256": {"$ref": "#/$defs/sha256"},
        "J_adapted_second_half_stream_sha256": {"$ref": "#/$defs/sha256"},
        "coder_continuity_stream_sha256": {"$ref": "#/$defs/sha256"},
        "P_J_parent_branch_identity_pass": {"type": "boolean"},
        "F_J_adapted_trajectory_identity_pass": {"type": "boolean"},
        "identical_truth_stream_pass": {"type": "boolean"},
        "parent_native_cadence_pass": {"type": "boolean"},
        "coder_not_forked_or_rewound_pass": {"type": "boolean"},
        "truth_only_shared_state_audit_pass": {"type": "boolean"},
        "no_writable_alias_pass": {"type": "boolean"},
        "no_adapted_persistent_write_survived_pass": {"type": "boolean"},
        "live_negative_mutation_control_pass": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_process_tree_rss_kib", "process_tree_limit_kib", "maximum_cgroup_memory_bytes",
        "cgroup_limit_bytes", "all_arm_resource_pass", "dependency_closure_pass",
        "incremental_package_bytes", "maximum_added_package_bytes", "package_pass"
      ],
      "properties": {
        "maximum_process_tree_rss_kib": {"type": "integer", "minimum": 0},
        "process_tree_limit_kib": {"const": 9765625},
        "maximum_cgroup_memory_bytes": {"type": "integer", "minimum": 0},
        "cgroup_limit_bytes": {"const": 10000000000},
        "all_arm_resource_pass": {"type": "boolean"},
        "dependency_closure_pass": {"type": "boolean"},
        "incremental_package_bytes": {"type": "integer", "minimum": 0},
        "maximum_added_package_bytes": {"const": 65536},
        "package_pass": {"type": "boolean"}
      }
    },
    "reported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "F_gain_bytes", "J_gain_bytes", "S_gain_bytes", "F_beats_S_pass",
        "retention_numerator_bytes", "retention_denominator_bytes",
        "retention_threshold_numerator", "retention_threshold_denominator",
        "fork_retention_pass"
      ],
      "properties": {
        "F_gain_bytes": {"type": "integer"},
        "J_gain_bytes": {"type": "integer"},
        "S_gain_bytes": {"type": "integer"},
        "F_beats_S_pass": {"type": "boolean"},
        "retention_numerator_bytes": {"type": "integer"},
        "retention_denominator_bytes": {"type": "integer"},
        "retention_threshold_numerator": {"const": 4},
        "retention_threshold_denominator": {"const": 5},
        "fork_retention_pass": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_classification", "scientific_verdict", "authorized_successor"],
      "properties": {
        "terminal_classification": {
          "enum": [
            "pass_local_fork_retains_at_least_0_8",
            "pass_persistent_effect_requires_functional_jvp",
            "pass_250k_exactness_authorize_1m",
            "pass_1m_target_scale_authorize_10m",
            "fail_full_oracle_subscale",
            "fail_causal_control",
            "fail_rejoin_identity",
            "fail_exactness_resource_or_package",
            "invalid_receipt"
          ]
        },
        "scientific_verdict": {"enum": ["pass", "fail", "none", "invalid"]},
        "authorized_successor": {
          "enum": [
            "cmix_obias_safe_fork_midas64_q0_v2",
            "cmix_obias_functional_jvp_persistence_attribution_q0_v1",
            "same_candidate_1m_calibration",
            "same_candidate_10m_attribution",
            "one_correction_only_rejoin_implementation_successor",
            "none_retire_cmix_midpoint_family",
            "none"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compression_credit_bytes", "score_credit_bytes"],
      "properties": {
        "compression_credit_bytes": {"const": 0},
        "score_credit_bytes": {"const": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"properties": {"raw_bytes": {"const": 250000}}}}},
      "then": {"properties": {"scope": {"properties": {"required_F_gain_bytes": {"const": 0}}}}}
    },
    {
      "if": {"properties": {"scope": {"properties": {"raw_bytes": {"const": 1000000}}}}},
      "then": {"properties": {"scope": {"properties": {"required_F_gain_bytes": {"const": 4080}}}}}
    },
    {
      "if": {"properties": {"scope": {"properties": {"raw_bytes": {"const": 10000000}}}}},
      "then": {"properties": {"scope": {"properties": {"required_F_gain_bytes": {"const": 40793}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm", "encode_return_code", "decode_return_code", "raw_inverse_return_code",
        "integer_probability_stream_sha256", "coder_state_stream_sha256",
        "persistent_state_stream_sha256", "archive_bytes", "archive_sha256",
        "repeat_archive_sha256", "decoded_sha256", "raw_inverse_pass",
        "repeat_identity_pass", "resource_pass", "dependency_closure_pass"
      ],
      "properties": {
        "arm": {"enum": ["P", "F", "J", "S"]},
        "encode_return_code": {"type": "integer"},
        "decode_return_code": {"type": "integer"},
        "raw_inverse_return_code": {"type": "integer"},
        "integer_probability_stream_sha256": {"$ref": "#/$defs/sha256"},
        "coder_state_stream_sha256": {"$ref": "#/$defs/sha256"},
        "persistent_state_stream_sha256": {"$ref": "#/$defs/sha256"},
        "archive_bytes": {"type": "integer", "minimum": 1},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "repeat_archive_sha256": {"$ref": "#/$defs/sha256"},
        "decoded_sha256": {"$ref": "#/$defs/sha256"},
        "raw_inverse_pass": {"type": "boolean"},
        "repeat_identity_pass": {"type": "boolean"},
        "resource_pass": {"type": "boolean"},
        "dependency_closure_pass": {"type": "boolean"}
      }
    }
  }
}
