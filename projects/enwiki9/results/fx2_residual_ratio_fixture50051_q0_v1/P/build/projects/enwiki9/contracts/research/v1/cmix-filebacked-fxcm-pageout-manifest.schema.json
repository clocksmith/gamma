{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-pageout-manifest.v1",
  "title": "CMIX file-backed FXCM pageout-cycle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "cadence_modeled_bytes", "terminal_modeled_bytes", "cycles"],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-filebacked-fxcm-pageout-manifest.v1"},
    "candidate_id": {"const": "cmix_obias_memory_safe_parent_filebacked_q1_v1"},
    "cadence_modeled_bytes": {"const": 1048576},
    "terminal_modeled_bytes": {"type": "integer", "minimum": 0},
    "cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cycle", "modeled_bytes", "reason", "calls"],
        "properties": {
          "cycle": {"type": "integer", "minimum": 0},
          "modeled_bytes": {"type": "integer", "minimum": 0},
          "reason": {"enum": ["post_initialization", "fixed_cadence"]},
          "calls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mapping_id", "registry_order", "return_code"],
              "properties": {
                "mapping_id": {"type": "integer", "minimum": 0},
                "registry_order": {"type": "integer", "minimum": 0},
                "return_code": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  }
}
