{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.dev/enwiki9/research/v1/submission-package-manifest.schema.json",
  "title": "gamma.enwiki9.submission-package-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageId",
    "selectedFormula",
    "thresholds",
    "physicalArtifacts",
    "embeddedComponents",
    "countedText",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "gamma.enwiki9.submission-package-manifest.v1" },
    "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "selectedFormula": {
      "enum": ["official_primary", "official_separate_archive"]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previousRecordBytes",
        "minimumAwardMaximumBytes",
        "gammaTargetBytes",
        "ruleContractPath"
      ],
      "properties": {
        "previousRecordBytes": { "type": "integer", "minimum": 1 },
        "minimumAwardMaximumBytes": { "type": "integer", "minimum": 1 },
        "gammaTargetBytes": { "type": "integer", "minimum": 1 },
        "ruleContractPath": { "type": "string", "minLength": 1 }
      }
    },
    "physicalArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "roles",
          "officialMultiplier",
          "gammaMultiplier",
          "runtimeRequired",
          "expectedBytes",
          "expectedSha256"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "compressor",
                "decompressor",
                "self_extracting_archive",
                "compressed_payload",
                "source_package",
                "model",
                "dictionary",
                "table",
                "runtime_support",
                "build_support",
                "license",
                "documentation"
              ]
            }
          },
          "officialMultiplier": { "type": "integer", "minimum": 0, "maximum": 2 },
          "gammaMultiplier": { "type": "integer", "minimum": 0, "maximum": 2 },
          "runtimeRequired": { "type": "boolean" },
          "expectedBytes": { "type": ["integer", "null"], "minimum": 0 },
          "expectedSha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "embeddedComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "containerArtifactId",
          "offset",
          "length",
          "sha256",
          "role"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "containerArtifactId": { "type": "string", "minLength": 1 },
          "offset": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": {
            "enum": [
              "decompressor",
              "compressed_payload",
              "model",
              "dictionary",
              "table",
              "runtime_support",
              "framing"
            ]
          }
        }
      }
    },
    "countedText": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "officialCounted", "gammaCounted"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "text": { "type": "string" },
          "officialCounted": { "type": "boolean" },
          "gammaCounted": { "type": "boolean" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256", "terminalPass"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "kind": {
            "enum": [
              "build",
              "inverse",
              "determinism",
              "resource",
              "dependency",
              "license"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "terminalPass": {
            "type": "boolean",
            "description": "Non-authoritative declaration; the accountant must independently verify the receipt schema and terminal pass fields."
          }
        }
      }
    }
  }
}
