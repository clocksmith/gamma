{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.dev/enwiki9/research/v1/experiment-result.schema.json",
  "title": "gamma.enwiki9.experiment-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "experimentId",
    "experiment",
    "analyzer",
    "status",
    "inputs",
    "population",
    "alignment",
    "metrics",
    "gateEvaluations",
    "decision",
    "scoreCreditBytes",
    "generatedUtc"
  ],
  "properties": {
    "schema": { "const": "gamma.enwiki9.experiment-result.v1" },
    "objective": { "$ref": "#/$defs/objectiveBinding" },
    "experimentId": { "$ref": "#/$defs/id" },
    "experiment": { "$ref": "#/$defs/reference" },
    "analyzer": { "$ref": "#/$defs/reference" },
    "status": { "enum": ["pass", "fail", "invalid"] },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namedReference" }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "branches", "segments", "segmentLength", "firstHalfLength"],
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "branches": { "type": "integer", "minimum": 1 },
        "segments": { "type": "integer", "minimum": 1 },
        "segmentLength": { "type": "integer", "minimum": 2 },
        "firstHalfLength": { "type": "integer", "minimum": 1 }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "rowIdentity", "symbolIdentity", "treeIdentity", "truthPathIdentity"],
      "properties": {
        "complete": { "type": "boolean" },
        "rowIdentity": { "type": "boolean" },
        "symbolIdentity": { "type": "boolean" },
        "treeIdentity": { "type": "boolean" },
        "truthPathIdentity": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignmentComplete",
        "allIdealSavingsBits",
        "firstHalfIdealSavingsBits",
        "secondHalfIdealSavingsBits",
        "secondHalfThirdSavingsBits",
        "secondHalfThirdMinSavingsBits",
        "secondHalfPositiveSegments",
        "secondHalfNegativeSegments",
        "secondHalfPositiveSegmentFraction",
        "changedBranchCount",
        "unchangedBranchCount",
        "maximumAbsoluteProbabilityDeltaCounts",
        "meanAbsoluteProbabilityDeltaCounts",
        "maximumAbsoluteDerivedLogitDelta",
        "secondHalfSegmentSavingsBitsQuantiles"
      ],
      "properties": {
        "alignmentComplete": { "type": "boolean" },
        "allIdealSavingsBits": { "type": "number" },
        "firstHalfIdealSavingsBits": { "type": "number" },
        "secondHalfIdealSavingsBits": { "type": "number" },
        "secondHalfThirdSavingsBits": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "secondHalfThirdMinSavingsBits": { "type": "number" },
        "secondHalfPositiveSegments": { "type": "integer", "minimum": 0 },
        "secondHalfNegativeSegments": { "type": "integer", "minimum": 0 },
        "secondHalfPositiveSegmentFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "changedBranchCount": { "type": "integer", "minimum": 0 },
        "unchangedBranchCount": { "type": "integer", "minimum": 0 },
        "maximumAbsoluteProbabilityDeltaCounts": { "type": "integer", "minimum": 0 },
        "meanAbsoluteProbabilityDeltaCounts": { "type": "number", "minimum": 0 },
        "maximumAbsoluteDerivedLogitDelta": { "type": "number", "minimum": 0 },
        "secondHalfSegmentSavingsBitsQuantiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "p05", "p25", "p50", "p75", "p95", "max"],
          "properties": {
            "min": { "type": "number" },
            "p05": { "type": "number" },
            "p25": { "type": "number" },
            "p50": { "type": "number" },
            "p75": { "type": "number" },
            "p95": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    },
    "gateEvaluations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pass", "predicates"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "pass": { "type": "boolean" },
          "predicates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "operator", "threshold", "observed", "pass"],
              "properties": {
                "metric": { "$ref": "#/$defs/id" },
                "operator": { "enum": ["eq", "gt", "gte", "lt", "lte"] },
                "threshold": { "type": ["boolean", "number"] },
                "observed": { "type": ["boolean", "number"] },
                "pass": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "rationale", "authorizedNextAction", "forbiddenClaims"],
      "properties": {
        "verdict": { "enum": ["authorize-deep-feature-instrumentation", "retire-deep-residual-lineage", "invalid-experiment"] },
        "rationale": { "type": "string", "minLength": 1 },
        "authorizedNextAction": { "type": ["string", "null"] },
        "forbiddenClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scoreCreditBytes": { "const": 0 },
    "generatedUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "namedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "objectiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectiveId", "objectiveDigest", "objectivePath", "targetScoreBytes", "corpusBytes", "corpusSha256"],
      "properties": {
        "objectiveId": { "type": "string", "minLength": 1 },
        "objectiveDigest": { "$ref": "#/$defs/digest" },
        "objectivePath": { "type": "string", "minLength": 1 },
        "targetScoreBytes": { "type": "integer", "minimum": 1 },
        "corpusBytes": { "type": "integer", "minimum": 1 },
        "corpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
