    <title>Image:GeorgeInness.JPG</title>
    <id>149829</id>
    <revision>
      <id>16038215</id>
      <timestamp>2004-10-27T02:19:39Z</timestamp>
      <contributor>
        <username>Infrogmation</username>
        <id>4444</id>
      </contributor>
      <text xml:space="preserve">[[George Inness]], scanned from an [[engraving]] in the 13 July, [[1867]] edition of &quot;[[Harper's Weekly]]&quot;

{{PD-old}}</text>
