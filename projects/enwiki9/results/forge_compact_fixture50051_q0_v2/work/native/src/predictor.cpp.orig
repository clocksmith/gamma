static_assert(FX3_BYTE_MIXER_OUTPUT_EPS >= 0.0f &&
              FX3_BYTE_MIXER_OUTPUT_EPS < 0.5f,
              "FX3_BYTE_MIXER_OUTPUT_EPS must be in [0, 0.5)");
static_assert(FX3_LSTM_LOWPROB_CONTEXT_THRESHOLD >= 0.0f &&
