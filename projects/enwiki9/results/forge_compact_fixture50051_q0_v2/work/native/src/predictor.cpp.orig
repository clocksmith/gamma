              FX3_LSTM_MIXER_CONTEXT_BUCKETS <= 16,
              "FX3_LSTM_MIXER_CONTEXT_BUCKETS must be in [0, 16]");
static_assert(FX3_LSTM_MIXER_CONTEXT_LR > 0.0f,
              "FX3_LSTM_MIXER_CONTEXT_LR must be > 0");
