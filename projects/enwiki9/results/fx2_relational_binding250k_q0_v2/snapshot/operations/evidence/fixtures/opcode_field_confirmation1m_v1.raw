      <text xml:space="preserve">{{Infobox German district|
name=Rhein-Erft-Kreis|
state=North Rhine-Westphalia|
capital=[[Bergheim, North Rhine-Westphalia|Bergheim]]|
regierungsbezirk=[[Cologne (region)|Cologne]]|
area=704.5|
population=455,487|
population_as_of=2001|
density=647|
carsign=BM|
url=http://www.erftkreis.de|
map=North_rhine_w_bm.png
