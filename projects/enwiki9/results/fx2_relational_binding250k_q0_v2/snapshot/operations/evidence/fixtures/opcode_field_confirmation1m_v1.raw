      <text xml:space="preserve">{| border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; width=&quot;250px&quot; align=&quot;right&quot; style=&quot;border-collapse: collapse; margin: 0 0 0 0.5em&quot;
