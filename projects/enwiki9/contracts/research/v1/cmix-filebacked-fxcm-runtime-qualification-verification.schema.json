{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-runtime-qualification-verification.v1",
  "title": "Independent CMIX file-backed FXCM runtime verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "source_receipt", "checks", "derived", "errors", "verification_pass", "claim_boundary", "gamma_score_credit_bytes"],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-filebacked-fxcm-runtime-qualification-verification.v1"},
    "candidate_id": {"const": "cmix_obias_memory_safe_parent_filebacked_q1_v1"},
    "source_receipt": {"$ref": "#/$defs/file"},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "derived": {
      "type": "object", "additionalProperties": false,
      "required": ["geekbench5_single_core_score", "wall_time_limit_seconds", "compression_elapsed_seconds", "decompression_elapsed_seconds", "compression_runtime_pass", "decompression_runtime_pass", "runtime_eligible"],
      "properties": {
        "geekbench5_single_core_score": {"type": "number", "exclusiveMinimum": 0},
        "wall_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "compression_elapsed_seconds": {"type": "number", "minimum": 0},
        "decompression_elapsed_seconds": {"type": "number", "minimum": 0},
        "compression_runtime_pass": {"type": "boolean"},
        "decompression_runtime_pass": {"type": "boolean"},
        "runtime_eligible": {"type": "boolean"}
      }
    },
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_pass": {"type": "boolean"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "gamma_score_credit_bytes": {"const": 0}
  },
  "allOf": [{
    "if": {"properties": {"verification_pass": {"const": true}}},
    "then": {"properties": {
      "checks": {"additionalProperties": {"const": true}},
      "derived": {"properties": {"runtime_eligible": {"const": true}}},
      "errors": {"maxItems": 0}
    }}
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
