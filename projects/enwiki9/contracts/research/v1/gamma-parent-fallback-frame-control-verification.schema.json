{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.local/contracts/research/v1/gamma-parent-fallback-frame-control-verification.schema.json",
  "title": "Gamma Parent-Fallback Frame Control Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "verified",
    "computed",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "gamma-parent-fallback-frame-control-verification.v1"
    },
    "program_id": {
      "const": "gamma_parent_fallback_archive_select_q0_v1"
    },
    "verified": {
      "type": "boolean"
    },
    "computed": {
      "type": [
        "object",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verified": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "computed": {
            "type": "object"
          },
          "errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
