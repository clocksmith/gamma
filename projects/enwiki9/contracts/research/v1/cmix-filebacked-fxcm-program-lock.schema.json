{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-program-lock.v1",
  "title": "CMIX file-backed FXCM frozen source-program lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "operational_status",
    "pending_declaration",
    "files",
    "file_manifest_sha256",
    "source_implementation_frozen",
    "claim_authority",
    "execution_authority"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-filebacked-fxcm-program-lock.v1"},
    "candidate_id": {"const": "cmix_obias_memory_safe_parent_filebacked_q1_v1"},
    "operational_status": {"const": "frozen"},
    "pending_declaration": {"$ref": "#/$defs/file"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "file_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_implementation_frozen": {"const": true},
    "claim_authority": {"const": "source_implementation_only"},
    "execution_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
