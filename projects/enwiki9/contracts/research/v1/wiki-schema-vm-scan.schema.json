{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.wiki-schema-vm-scan.v1",
  "title": "WIKI-SCHEMA-VM zero-credit causal ceiling scan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "population_bytes",
    "population_sha256_expected",
    "templates_opened",
    "templates_completed",
    "depth_overflows",
    "atom_overflows",
    "staging_overflows",
    "named_keys_completed",
    "completed_template_updates",
    "programs_activated",
    "opportunity_bytes",
    "treatment_correct_bytes",
    "random_correct_bytes",
    "shifted_correct_bytes",
    "treatment_minus_random_correct_bytes",
    "treatment_minus_shifted_correct_bytes",
    "treatment_correct_by_third",
    "minimum_third_treatment_correct_bytes",
    "table_lookups",
    "table_hits",
    "table_inserts",
    "table_set_replacements",
    "table_candidate_replacements",
    "table_updates",
    "opportunity_fnv1a64",
    "parser_fnv1a64",
    "table_fnv1a64",
    "bounded_state_pass",
    "archive_authority",
    "score_credit_bytes"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.wiki-schema-vm-scan.v1"},
    "candidate_id": {"const": "wiki_schema_vm_ceiling_q0_v1"},
    "population_bytes": {"const": 587138826},
    "population_sha256_expected": {
      "const": "7826ff63dedd526c119dda08e6e044be8fa8f6e89a55f3d6b1f3447cdfc5c1ce"
    },
    "templates_opened": {"$ref": "#/$defs/count"},
    "templates_completed": {"$ref": "#/$defs/count"},
    "depth_overflows": {"$ref": "#/$defs/count"},
    "atom_overflows": {"$ref": "#/$defs/count"},
    "staging_overflows": {"$ref": "#/$defs/count"},
    "named_keys_completed": {"$ref": "#/$defs/count"},
    "completed_template_updates": {"$ref": "#/$defs/count"},
    "programs_activated": {"$ref": "#/$defs/count"},
    "opportunity_bytes": {"$ref": "#/$defs/count"},
    "treatment_correct_bytes": {"$ref": "#/$defs/count"},
    "random_correct_bytes": {"$ref": "#/$defs/count"},
    "shifted_correct_bytes": {"$ref": "#/$defs/count"},
    "treatment_minus_random_correct_bytes": {"type": "integer"},
    "treatment_minus_shifted_correct_bytes": {"type": "integer"},
    "treatment_correct_by_third": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/count"}
    },
    "minimum_third_treatment_correct_bytes": {"$ref": "#/$defs/count"},
    "table_lookups": {"$ref": "#/$defs/count"},
    "table_hits": {"$ref": "#/$defs/count"},
    "table_inserts": {"$ref": "#/$defs/count"},
    "table_set_replacements": {"$ref": "#/$defs/count"},
    "table_candidate_replacements": {"$ref": "#/$defs/count"},
    "table_updates": {"$ref": "#/$defs/count"},
    "opportunity_fnv1a64": {"$ref": "#/$defs/fnv64"},
    "parser_fnv1a64": {"$ref": "#/$defs/fnv64"},
    "table_fnv1a64": {"$ref": "#/$defs/fnv64"},
    "bounded_state_pass": {"const": true},
    "archive_authority": {"const": false},
    "score_credit_bytes": {"const": 0}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "fnv64": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
  }
}
