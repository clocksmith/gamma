{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-mapping-manifest.v1",
  "title": "CMIX file-backed FXCM allocation and path manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "scratch_path",
    "path_components",
    "initial_entries",
    "minimum_backed_allocation_bytes",
    "maximum_registered_allocations",
    "mappings"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.cmix-filebacked-fxcm-mapping-manifest.v1"},
    "candidate_id": {"const": "cmix_obias_memory_safe_parent_filebacked_q1_v1"},
    "scratch_path": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).*[^/]$"
    },
    "path_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "name", "device", "inode", "mode", "is_directory", "is_symlink"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/]+$"},
          "device": {"type": "integer", "minimum": 0},
          "inode": {"type": "integer", "minimum": 1},
          "mode": {"type": "integer", "minimum": 0},
          "is_directory": {"type": "boolean"},
          "is_symlink": {"type": "boolean"}
        }
      }
    },
    "initial_entries": {
      "type": "array",
      "maxItems": 0
    },
    "minimum_backed_allocation_bytes": {"const": 67108864},
    "maximum_registered_allocations": {"const": 4096},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/mapping"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id",
        "registry_order",
        "allocation_kind",
        "requested_bytes",
        "mapping_bytes",
        "alignment",
        "mapping_base",
        "usable_pointer",
        "filename",
        "device",
        "inode",
        "mode",
        "file_size_bytes",
        "posix_fallocate_return_code",
        "mmap_return_code",
        "anonymous_fallback",
        "zero_probe_bytes",
        "zero_probe_sha256",
        "release_modeled_byte"
      ],
      "properties": {
        "allocation_id": {"type": "integer", "minimum": 0},
        "registry_order": {"type": "integer", "minimum": 0},
        "allocation_kind": {"enum": ["alloc", "alloc1"]},
        "requested_bytes": {"type": "integer", "minimum": 67108864},
        "mapping_bytes": {"type": "integer", "minimum": 67108864},
        "alignment": {"type": "integer", "minimum": 1},
        "mapping_base": {"type": "integer", "minimum": 1},
        "usable_pointer": {"type": "integer", "minimum": 1},
        "filename": {"type": "string", "pattern": "^fxcm-[0-9]{4}\\.bin$"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "mode": {"const": 384},
        "file_size_bytes": {"type": "integer", "minimum": 67108864},
        "posix_fallocate_return_code": {"type": "integer"},
        "mmap_return_code": {"type": "integer"},
        "anonymous_fallback": {"type": "boolean"},
        "zero_probe_bytes": {"type": "integer", "minimum": 1},
        "zero_probe_sha256": {"$ref": "#/$defs/sha256"},
        "release_modeled_byte": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
