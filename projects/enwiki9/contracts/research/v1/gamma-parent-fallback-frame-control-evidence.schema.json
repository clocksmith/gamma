{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.local/contracts/research/v1/gamma-parent-fallback-frame-control-evidence.schema.json",
  "title": "Gamma Parent-Fallback Frame Control Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "binary_sha256",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "const": "gamma-parent-fallback-frame-control-evidence.v1"
    },
    "program_id": {
      "const": "gamma_parent_fallback_archive_select_q0_v1"
    },
    "binary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bad_magic",
        "bad_version",
        "bad_mode",
        "short_header",
        "short_payload",
        "trailing_bytes",
        "existing_output",
        "symlink_input",
        "nonregular_input"
      ],
      "properties": {
        "bad_magic": {
          "$ref": "#/$defs/control"
        },
        "bad_version": {
          "$ref": "#/$defs/control"
        },
        "bad_mode": {
          "$ref": "#/$defs/control"
        },
        "short_header": {
          "$ref": "#/$defs/control"
        },
        "short_payload": {
          "$ref": "#/$defs/control"
        },
        "trailing_bytes": {
          "$ref": "#/$defs/control"
        },
        "existing_output": {
          "$ref": "#/$defs/control"
        },
        "symlink_input": {
          "$ref": "#/$defs/control"
        },
        "nonregular_input": {
          "$ref": "#/$defs/control"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "return_code",
        "stdout",
        "stderr",
        "output_exists"
      ],
      "properties": {
        "return_code": {
          "type": "integer"
        },
        "stdout": {
          "$ref": "#/$defs/stream"
        },
        "stderr": {
          "$ref": "#/$defs/stream"
        },
        "output_exists": {
          "type": "boolean"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "link_target": {
          "type": "string",
          "minLength": 1
        },
        "output_before_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_after_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
