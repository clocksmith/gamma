{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/clockwork/v1/route-binding.schema.json",
  "title": "clockwork.route_binding.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "routeBindingId",
    "disposition",
    "sealVersion",
    "theoremStatementDigest",
    "hypothesisIds",
    "conclusionIds",
    "applicationCertificateDigest",
    "extractor",
    "accounting",
    "requiredMargins",
    "privateVerifierDigest",
    "syntheticWitnessReceiptDigests",
    "createdAt",
    "artifactDigest"
  ],
  "properties": {
    "schema": { "const": "clockwork.route_binding.v1" },
    "routeBindingId": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["draft", "bound", "rejected"] },
    "sealVersion": { "type": "string", "minLength": 1 },
    "theoremStatementDigest": { "$ref": "#/$defs/digest" },
    "hypothesisIds": { "$ref": "#/$defs/nonEmptyStrings" },
    "conclusionIds": { "$ref": "#/$defs/nonEmptyStrings" },
    "applicationCertificateDigest": { "$ref": "#/$defs/digest" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceDigest", "inputSchemaDigest", "outputSchemaDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "inputSchemaDigest": { "$ref": "#/$defs/digest" },
        "outputSchemaDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageExpression", "runtimeExpression", "memoryExpression"],
      "properties": {
        "packageExpression": { "type": "string", "minLength": 1 },
        "runtimeExpression": { "type": "string", "minLength": 1 },
        "memoryExpression": { "type": "string", "minLength": 1 }
      }
    },
    "requiredMargins": { "type": "object", "minProperties": 1 },
    "privateVerifierDigest": { "$ref": "#/$defs/digest" },
    "syntheticWitnessReceiptDigests": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "artifactDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
