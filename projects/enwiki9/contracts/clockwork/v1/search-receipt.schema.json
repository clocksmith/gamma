{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/clockwork/v1/search-receipt.schema.json",
  "title": "clockwork.search_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "contractSetDigest",
    "challengeDigest",
    "kernelDigest",
    "evaluatorDigest",
    "populationDigest",
    "seeds",
    "implementation",
    "environment",
    "lineage",
    "evaluations",
    "negativeResults",
    "paretoFrontier",
    "replayDigest",
    "determinism",
    "receiptDigest"
  ],
  "properties": {
    "schema": { "const": "clockwork.search_receipt.v1" },
    "authority": { "const": "advisory" },
    "contractSetDigest": { "$ref": "#/$defs/digest" },
    "challengeDigest": { "$ref": "#/$defs/digest" },
    "kernelDigest": { "$ref": "#/$defs/digest" },
    "evaluatorDigest": { "$ref": "#/$defs/digest" },
    "populationDigest": { "$ref": "#/$defs/digest" },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "implementation": { "type": "object", "minProperties": 1 },
    "environment": { "type": "object", "minProperties": 1 },
    "lineage": { "type": "array", "items": { "type": "object" } },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidateDigest", "valid", "objectives", "rawLedger"],
        "properties": {
          "candidateDigest": { "$ref": "#/$defs/digest" },
          "valid": { "type": "boolean" },
          "objectives": { "type": "object" },
          "rawLedger": { "type": "object" }
        }
      }
    },
    "negativeResults": { "type": "array", "items": { "type": "object" } },
    "paretoFrontier": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" }
    },
    "replayDigest": { "$ref": "#/$defs/digest" },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rerunCount", "byteIdentical"],
      "properties": {
        "rerunCount": { "type": "integer", "minimum": 2 },
        "byteIdentical": { "const": true }
      }
    },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
