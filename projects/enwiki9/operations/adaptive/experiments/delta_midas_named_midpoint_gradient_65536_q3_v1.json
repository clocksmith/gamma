  "hypothesis": {
    "claim": "The production F arm's exact first-half midpoint gradient has one stable non-head parameter-group concentration across every chronological third, localizing one deep group for a separately frozen causal ablation.",
    "falsification": "Retire gradient-energy localization if exact repeated F archives and named gradients are valid but no single non-head group dominates every third with the frozen share and output-head bounds."
  },
  "changedMechanism": "Replace only q2's post-reduction F32 conversion with LibNC's direct F32 squared-sum reducer, record an explicit BF16-to-F32 multiply-and-sum reference for every row, stream native stderr durably, and preserve all codec probabilities, update behavior, population, grouping, and inherited science thresholds.",
  "invariants": [
    "The emitted archive must remain byte-identical to the retained production F archive.",
    "Two independent instrumented encodes must emit byte-identical archives and named gradient rows.",
    "Every midpoint block must expose the same complete named parameter set and finite gradient energies.",
    "The q1 implementation may change only tensor-reference ownership and failure-stream retention; grouping, thresholds, population, update behavior, and probabilities remain q0-identical.",
    "Gradient magnitude is localization evidence only and is not probability contribution, codec gain, or objective credit.",
    "No group ablation, open correction, or additive forecast is authorized by this experiment itself.",
    "Direct fused and explicit F32 reference energies must be finite and agree within relative error 0.001 before either promotion or retirement is valid.",
    "Q2 low-precision comparisons are diagnostic sensitivity measurements only and must not participate in promotion or kill predicates."
  ],
  "controls": [
    {
      "id": "instrumented-f-repeat",
      "role": "treatment",
      "definition": "Two clean builds of the same reference-safe instrumented production F encode path with named gradient capture enabled only during each first-half midpoint backward pass."
    },
    {
      "id": "retained-f-archive",
      "role": "comparator",
      "definition": "The hash-bound uninstrumented production F archive already independently decoded to the exact raw population."
    },
    {
      "id": "q0-reference-ownership-abort",
      "role": "negative",
      "definition": "The q0 implementation passed the callback-owned gradient directly to consuming nc_tensor_isfinite and reproducibly aborted in nc_free_tensor before the first archive completed."
    },
    {
      "id": "output-head-share",
      "role": "negative",
      "definition": "The previously failed output-head-only mechanism remains excluded; a head-dominated gradient cannot authorize a deep-group successor."
    },
    {
      "id": "q1-non-f32-scalar-abort",
      "role": "negative",
      "definition": "Q1 correctly preserved callback reference ownership but passed a non-F32 squared-energy reduction to the F32-only scalar reader and aborted before the first archive completed."
    },
    {
      "id": "q2-post-reduction-f32-invalid",
      "role": "negative",
      "definition": "Q2 converts only after BF16 square and reduction; it proves deterministic execution but cannot authorize or retire numeric localization."
    }
  ],
