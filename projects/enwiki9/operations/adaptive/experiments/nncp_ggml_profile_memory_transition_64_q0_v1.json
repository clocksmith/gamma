  "hypothesis": {
    "claim": "For every production layer, shifting the retained 256-position decoder memory by 64 positions and appending the exact open layer-input sequence reconstructs the teacher's next-segment memory byte-for-byte, deterministically across two open executions.",
    "falsification": "If the frozen exact-forward and replay inputs validate but any reconstructed layer memory differs, retire the explicit shift-and-append open memory transition before attempting a later segment or parameter update."
  },
  "changedMechanism": "Compile only LibNC mem_update into an explicit source-counted shift-and-append transform over the retained initial BF16 memory and exact 64-position layer inputs; no parameter update or second-segment forward is performed.",
  "invariants": [
    "The Q1 decision/reflection and Q18 decision, fixture, source closure, and guard must match their frozen digests.",
    "The Q1 exact arithmetic patch is applied unchanged before both open executions.",
    "Teacher next memory is reconstructed only from the receipt-bound initial teacher memory and ordered teacher layer-input tensors.",
    "Open next memory is reconstructed independently from the same initial memory and each open execution\u2019s own layer-input tensors.",
    "All twenty layers preserve the exact 256-position memory geometry; no tolerance or floating comparison is allowed.",
    "Parameter gradients, optimizer state, later-segment probabilities, archive savings, and objective credit remain outside this gate."
  ],
  "controls": [
    {
      "id": "teacher-memory-transition",
      "role": "comparator",
      "definition": "For each layer, the retained teacher memory drops its oldest 64 positions and appends the ordered 64 teacher layer-input tensors."
    },
    {
      "id": "open-memory-transition",
      "role": "treatment",
      "definition": "The first rebuilt exact open execution applies the same explicit transition to its independently produced layer-input tensor."
    },
    {
      "id": "open-memory-transition-repeat",
      "role": "replay",
      "definition": "A second execution must reproduce every next-memory layer digest and aggregate digest exactly."
    }
  ],
