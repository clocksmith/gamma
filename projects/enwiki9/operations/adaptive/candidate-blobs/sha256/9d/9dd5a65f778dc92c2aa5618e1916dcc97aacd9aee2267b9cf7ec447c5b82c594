{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.dev/enwiki9/research/v1/clean-room-attempt.schema.json",
  "title": "gamma.enwiki9.clean_room_attempt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "candidateId",
    "candidateTreeSha256",
    "manifest",
    "corpus",
    "error",
    "executions",
    "retainedArtifacts",
    "scratchCleaned",
    "generatedUtc"
  ],
  "properties": {
    "schema": { "const": "gamma.enwiki9.clean-room-attempt.v1" },
    "objective": { "$ref": "#/$defs/objectiveBinding" },
    "candidateId": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "candidateTreeSha256": { "$ref": "#/$defs/digest" },
    "manifest": { "$ref": "#/$defs/reference" },
    "corpus": { "$ref": "#/$defs/artifact" },
    "error": { "type": "string", "minLength": 1 },
    "executions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "command", "returncode", "guard", "log"],
        "properties": {
          "phase": {
            "enum": ["build-first", "compression", "build-replay", "compression-replay", "build-decode", "decompression"]
          },
          "command": { "$ref": "#/$defs/command" },
          "returncode": { "type": "integer" },
          "guard": {
            "oneOf": [
              { "$ref": "#/$defs/reference" },
              { "type": "null" }
            ]
          },
          "log": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "retainedArtifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "scratchCleaned": { "type": "boolean" },
    "generatedUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "objectiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectiveId", "objectiveDigest", "objectivePath", "targetScoreBytes", "corpusBytes", "corpusSha256"],
      "properties": {
        "objectiveId": { "type": "string", "minLength": 1 },
        "objectiveDigest": { "$ref": "#/$defs/digest" },
        "objectivePath": { "type": "string", "minLength": 1 },
        "targetScoreBytes": { "type": "integer", "minimum": 1 },
        "corpusBytes": { "type": "integer", "minimum": 1 },
        "corpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
