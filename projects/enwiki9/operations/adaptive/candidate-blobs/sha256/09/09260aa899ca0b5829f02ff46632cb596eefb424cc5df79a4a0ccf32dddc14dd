{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamma.local/contracts/research/v1/cmix-source-labelled-memory-attribution-verification.schema.json",
  "title": "CMIX Source-Labelled Memory Attribution Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "verified",
    "computed",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "cmix-source-labelled-memory-attribution-verification.v1"
    },
    "candidate_id": {
      "const": "cmix_obias_source_labelled_memory_attribution_q0_v1"
    },
    "verified": {
      "type": "boolean"
    },
    "computed": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/computed"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "computed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_ranges",
        "page_entries",
        "labelled_resident_lower_bound_kib",
        "labelled_resident_upper_bound_kib",
        "eligible_fxcm_reclaimable_lower_bound_kib",
        "required_reduction_kib",
        "successor_should_be_authorized"
      ],
      "properties": {
        "allocation_ranges": {
          "type": "integer",
          "minimum": 0
        },
        "page_entries": {
          "type": "integer",
          "minimum": 0
        },
        "labelled_resident_lower_bound_kib": {
          "type": "integer",
          "minimum": 0
        },
        "labelled_resident_upper_bound_kib": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_fxcm_reclaimable_lower_bound_kib": {
          "type": "integer",
          "minimum": 0
        },
        "required_reduction_kib": {
          "const": 1472880
        },
        "successor_should_be_authorized": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verified": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "computed": {
            "$ref": "#/$defs/computed"
          },
          "errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
