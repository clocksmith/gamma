        "wrong_linker": {"const": true},
        "response_file": {"const": true},
        "live_root": {"const": true},
        "failed_invocation": {"const": true},
        "missing_production": {"const": true},
        "testing_leak": {"const": true},
        "macro_undefine": {"const": true},
        "split_definition": {"const": true},
        "no_compile_event": {"const": true},
        "missing_linker_selection": {"const": true},
