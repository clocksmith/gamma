    "execution_authority": {"const": false},
    "archive_authority": {"const": false},
    "score_credit_bytes": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "candidate_id", "probability_scale", "controls", "pending_state_digest_pass", "identity_control_pass", "all_controls_pass", "execution_authority", "archive_authority", "score_credit_bytes"],
