    "normalized_argv": {"type": "array", "prefixItems": [{"const": "{NEGATIVE_CONTROLS_BINARY}"}], "items": false},
    "command_sha256": {"$ref": "#/$defs/sha256"},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "return_code": {"const": 0},
    "stdout_bytes": {"type": "integer", "minimum": 1},
    "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "subject_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "subject": {"$ref": "#/$defs/subject"},
    "exclusive_lease_absent_pass": {"const": true},
