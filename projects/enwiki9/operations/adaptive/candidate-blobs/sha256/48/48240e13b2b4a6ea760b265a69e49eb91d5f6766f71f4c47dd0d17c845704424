  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "input_lock", "normalized_argv", "command_sha256", "environment_sha256", "return_code", "stdout_bytes", "stdout_sha256", "stderr_bytes", "stderr_sha256", "subject_canonical_sha256", "subject", "exclusive_lease_absent_pass", "terminal_pass", "execution_authority", "archive_authority", "score_credit_bytes"],
  "properties": {
    "schema": {"const": "gamma.enwiki9.safe-mix-negative-controls-execution-receipt.v1"},
    "candidate_id": {"const": "gamma_safe_mix_v1"},
    "input_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_lock_sha256", "build_receipt_sha256", "independent_build_verification_sha256", "binary_sha256", "capture_sha256", "python_executable_sha256"],
      "properties": {
        "program_lock_sha256": {"$ref": "#/$defs/sha256"},
        "build_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "independent_build_verification_sha256": {"$ref": "#/$defs/sha256"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "capture_sha256": {"$ref": "#/$defs/sha256"},
        "python_executable_sha256": {"$ref": "#/$defs/sha256"}
      }
