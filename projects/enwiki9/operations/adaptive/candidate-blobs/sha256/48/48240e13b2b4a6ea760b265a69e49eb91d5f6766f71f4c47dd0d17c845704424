        "schema": {"const": "gamma.enwiki9.safe-mix-negative-controls-receipt.v1"},
        "candidate_id": {"const": "gamma_safe_mix_v1"},
        "probability_scale": {"const": 4096},
        "controls": {
          "type": "object",
