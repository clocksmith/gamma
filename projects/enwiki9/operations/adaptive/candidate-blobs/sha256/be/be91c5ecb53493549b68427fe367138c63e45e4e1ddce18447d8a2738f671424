{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.gamma-mechanism-ir-compilation-verification.v2",
  "title": "Gamma Mechanism IR closure-aware compilation verification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mechanism_id",
    "verified",
    "errors",
    "compiler_sha256",
    "source_ir_sha256",
    "causal_closure_sha256",
    "repeat",
    "negative_controls",
    "evidence_root",
    "claim_authority",
    "execution_authority",
    "promotion_authority"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.gamma-mechanism-ir-compilation-verification.v2"},
    "mechanism_id": {"type": "string", "minLength": 1},
    "verified": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "compiler_sha256": {"$ref": "#/$defs/sha256"},
    "source_ir_sha256": {"$ref": "#/$defs/sha256"},
    "causal_closure_sha256": {"$ref": "#/$defs/sha256"},
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_a_return_code", "run_b_return_code", "receipt_identity_pass", "artifact_identity_pass", "artifact_set_sha256"],
      "properties": {
        "run_a_return_code": {"type": "integer"},
        "run_b_return_code": {"type": "integer"},
        "receipt_identity_pass": {"type": "boolean"},
        "artifact_identity_pass": {"type": "boolean"},
        "artifact_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "negative_controls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["return_code", "rejected", "no_final_output_pass", "stdout_sha256", "stderr_sha256"],
        "properties": {
          "return_code": {"type": "integer"},
          "rejected": {"type": "boolean"},
          "no_final_output_pass": {"type": "boolean"},
          "stdout_sha256": {"$ref": "#/$defs/sha256"},
          "stderr_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "evidence_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regular_file_count", "regular_file_bytes", "manifest_sha256", "filesystem_anomaly_absence_pass"],
      "properties": {
        "regular_file_count": {"type": "integer", "minimum": 1},
        "regular_file_bytes": {"type": "integer", "minimum": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "filesystem_anomaly_absence_pass": {"type": "boolean"}
      }
    },
    "claim_authority": {"const": "none"},
    "execution_authority": {"const": false},
    "promotion_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
