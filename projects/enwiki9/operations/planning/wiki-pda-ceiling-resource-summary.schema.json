    "candidate_id": {"const": "wiki_pda_structural_replay_ceiling_q0_v2"},
    "arms": {"type": "object", "additionalProperties": false, "required": ["a", "b"], "properties": {"a": {"$ref": "#/$defs/artifact"}, "b": {"$ref": "#/$defs/artifact"}}},
