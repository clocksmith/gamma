    "maximum_scratch_allocated_bytes": {"type": "integer", "minimum": 0},
    "cgroup_max_events": {"type": "integer", "minimum": 0},
    "cgroup_oom_events": {"type": "integer", "minimum": 0},
    "cgroup_oom_kill_events": {"type": "integer", "minimum": 0},
    "all_resource_predicates_pass": {"type": "boolean"}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
