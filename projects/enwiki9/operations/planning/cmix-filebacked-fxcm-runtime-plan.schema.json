{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.cmix-filebacked-fxcm-runtime-plan.v1",
  "title": "Source-bound q1 exact-package runtime execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_id", "revision", "operational_status", "claim_authority",
    "objective", "dependencies", "implementation", "source_closure_roots", "working_directory",
    "contract", "activation_requirements", "command", "kill_condition",
    "execution_authorized", "promotion_authority", "gamma_compression_credit_bytes",
    "gamma_score_credit_bytes"
  ],
  "properties": {
    "$schema": {"const": "gamma.enwiki9.cmix-filebacked-fxcm-runtime-plan.v1"},
    "artifact_id": {"const": "cmix_filebacked_fxcm_runtime_qualification_q0_v1"},
    "revision": {"const": 2},
    "operational_status": {"const": "dormant_dependency"},
    "claim_authority": {"const": "none"},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "corpus_bytes", "target_complete_counted_bytes"],
      "properties": {
        "objective_id": {"const": "gamma-enwik9-hutter-105m-v1"},
        "corpus_bytes": {"const": 1000000000},
        "target_complete_counted_bytes": {"const": 105000000}
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "required_evidence"],
        "properties": {
          "artifact": {"$ref": "#/$defs/text"},
          "required_evidence": {"$ref": "#/$defs/text"}
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinator", "independent_verifier", "stage_runner", "stage_schema", "resource_guard",
        "managed_lease", "receipt_schema", "verification_schema",
        "host_fingerprint_schema", "plan_schema", "python_source_closure"
      ],
      "properties": {
        "coordinator": {"$ref": "#/$defs/binding"},
        "independent_verifier": {"$ref": "#/$defs/binding"},
        "stage_runner": {"$ref": "#/$defs/binding"},
        "stage_schema": {"$ref": "#/$defs/binding"},
        "resource_guard": {"$ref": "#/$defs/binding"},
        "managed_lease": {"$ref": "#/$defs/binding"},
        "receipt_schema": {"$ref": "#/$defs/binding"},
        "verification_schema": {"$ref": "#/$defs/binding"},
        "host_fingerprint_schema": {"$ref": "#/$defs/binding"},
        "plan_schema": {"$ref": "#/$defs/binding"},
        "python_source_closure": {"$ref": "#/$defs/binding"}
      }
    },
    "source_closure_roots": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(tools|contracts)/"}
    },
    "working_directory": {"const": "/home/x/deco/gamma/projects/enwiki9"},
    "contract": {"type": "object", "minProperties": 1},
    "activation_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/text"}
    },
    "command": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string"}
    },
    "kill_condition": {"$ref": "#/$defs/text"},
    "execution_authorized": {"const": true},
    "promotion_authority": {"const": false},
    "gamma_compression_credit_bytes": {"const": 0},
    "gamma_score_credit_bytes": {"const": 0}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(tools|contracts|operations)/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
