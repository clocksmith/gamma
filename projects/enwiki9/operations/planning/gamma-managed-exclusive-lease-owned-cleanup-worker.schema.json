{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma.enwiki9.managed-exclusive-lease-owned-cleanup-worker.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "candidate_id", "command", "command_sha256", "source_lock",
    "controls", "work_manifest", "controls_returncode", "lease_release_pass",
    "namespace_free_pass", "errors", "terminal_pass", "claim_authority",
    "promotion_authority", "gamma_compression_credit_bytes", "gamma_score_credit_bytes"
  ],
  "properties": {
    "schema": {"const": "gamma.enwiki9.managed-exclusive-lease-owned-cleanup-worker.v1"},
    "candidate_id": {"const": "gamma_managed_exclusive_lease_owned_cleanup_q0_v1"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_lock": {"type": "object"},
    "controls": {"type": ["object", "null"]},
    "work_manifest": {"type": ["object", "null"]},
    "controls_returncode": {"type": ["integer", "null"]},
    "lease_release_pass": {"type": "boolean"},
    "namespace_free_pass": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "terminal_pass": {"type": "boolean"},
    "claim_authority": {"const": "infrastructure_only"},
    "promotion_authority": {"const": false},
    "gamma_compression_credit_bytes": {"const": 0},
    "gamma_score_credit_bytes": {"const": 0}
  }
}
