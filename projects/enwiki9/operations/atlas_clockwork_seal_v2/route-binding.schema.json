{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_clockwork.route_binding/v1",
  "type": "object",
  "required": [
    "schema",
    "route_id",
    "theorem_id",
    "binding_status",
    "publication_status",
    "canonical_map_kind",
    "score_credit_bytes"
  ],
  "properties": {
    "schema": {"const": "atlas_clockwork.route_decision/v1"},
    "route_id": {"enum": ["A", "B", "C", "D"]},
    "theorem_id": {"type": "string", "minLength": 1},
    "binding_status": {"enum": ["bound", "rejected"]},
    "publication_status": {"enum": ["authorized", "removed"]},
    "canonical_map_kind": {"type": "string", "minLength": 1},
    "score_credit_bytes": {"type": "integer", "minimum": 0},
    "hypothesis_certificate": {"type": "string"},
    "conditional_reduction": {"type": "string"},
    "canonical_map": {"type": "string"},
    "verification_receipt": {"type": "string"},
    "missing_antecedents": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reason": {"type": "string"}
  }
}
