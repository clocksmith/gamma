{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clocksmith/gamma/projects/distillation/translation/promotion/error-ledger.schema.json",
  "title": "Translation row-level error ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerId", "role", "population", "systems", "errorTaxonomy", "rows"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "ledgerId": { "type": "string", "minLength": 1 },
    "role": { "const": "diagnostic_only" },
    "population": {
      "type": "object",
      "required": ["path", "sha256", "rows"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rows": { "type": "integer", "minimum": 1 }
      }
    },
    "systems": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "errorTaxonomy": {
      "const": ["omission", "morphology", "entity", "number", "negation", "idiom", "direction_contract"]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rowId",
          "rowIndex",
          "direction",
          "sourceSha256",
          "referenceSha256",
          "systems",
          "adjudication"
        ],
        "properties": {
          "rowId": { "type": "string" },
          "rowIndex": { "type": "integer", "minimum": 0 },
          "direction": { "enum": ["en-es", "es-en"] },
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "referenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "systems": { "type": "object" },
          "adjudication": {
            "type": "object",
            "required": ["status", "labels", "reviewerIds", "notes"],
            "properties": {
              "status": { "enum": ["pending", "complete"] },
              "labels": {
                "type": "array",
                "items": { "enum": ["omission", "morphology", "entity", "number", "negation", "idiom", "direction_contract"] }
              },
              "reviewerIds": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
