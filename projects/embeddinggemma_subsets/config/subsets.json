{
  "base_model": "google/embeddinggemma-300m",
  "out_root": "gamma/projects/embeddinggemma_subsets/output",
  "defaults": {
    "top_k": 50000,
    "min_count": 1,
    "max_lines": null,
    "write_checkpoint": true,
    "also_prune_output": false,
    "dtype": "auto"
  },
  "subsets": [
    {
      "tag": "en",
      "texts": ["gamma/projects/embeddinggemma_subsets/data/en.txt"]
    },
    {
      "tag": "es",
      "texts": ["gamma/projects/embeddinggemma_subsets/data/es.txt"]
    },
    {
      "tag": "ja",
      "texts": ["gamma/projects/embeddinggemma_subsets/data/ja.txt"]
    },
    {
      "tag": "ar",
      "texts": ["gamma/projects/embeddinggemma_subsets/data/ar.txt"]
    }
  ]
}

