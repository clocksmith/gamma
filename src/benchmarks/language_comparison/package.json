{
  "name": "@dream/llm-benchmark",
  "version": "1.0.0",
  "description": "Comprehensive LLM benchmarking suite for TypeScript and JavaScript tasks",
  "type": "module",
  "main": "index.js",
  "bin": {
    "llm-benchmark": "./index.js"
  },
  "scripts": {
    "benchmark": "node index.js",
    "benchmark:simple": "node index.js --category simple",
    "benchmark:web": "node index.js --category web-components",
    "benchmark:ui": "node index.js --category ui-components",
    "benchmark:typescript": "node index.js --variant typescript",
    "benchmark:react": "node index.js --variant typescript-react",
    "list": "node index.js --list-tasks",
    "reports": "open reports/dashboard.html"
  },
  "keywords": [
    "benchmark",
    "llm",
    "typescript",
    "javascript",
    "testing",
    "evaluation",
    "code-generation",
    "ai",
    "gpt",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
