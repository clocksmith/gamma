{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-2038.local/schemas/simulation-report-v8.schema.json",
  "title": "Mandate 2038 Simulation Report v8",
  "type": "object",
  "required": [
    "schemaVersion",
    "reportSchemaVersion",
    "replaySchemaVersion",
    "decisionSchemaVersion",
    "reportType",
    "evidenceLabel",
    "evidenceType",
    "generatedAt",
    "seed",
    "playerCount",
    "game",
    "engine",
    "variant",
    "strategies",
    "experiment",
    "rng",
    "provenance",
    "balanceContract",
    "balanceEvaluation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 8
    },
    "reportSchemaVersion": {
      "const": 8
    },
    "replaySchemaVersion": {
      "const": 4
    },
    "decisionSchemaVersion": {
      "const": 2
    },
    "reportType": {
      "enum": [
        "tournament",
        "strategy_evolution",
        "rule_search",
        "balance_audit",
        "unified_matrix_audit",
        "llm_negotiation_holdout"
      ]
    },
    "evidenceLabel": {
      "const": "simulation"
    },
    "evidenceType": {
      "const": "simulation"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "seed": {
      "type": "string"
    },
    "playerCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5
    },
    "game": {
      "type": "object",
      "required": [
        "version",
        "releaseStatus",
        "rulesetFingerprint",
        "playtestKitFingerprint"
      ]
    },
    "engine": {
      "type": "object",
      "required": [
        "id",
        "version",
        "coverageId",
        "fingerprint"
      ]
    },
    "variant": {
      "type": "object",
      "required": [
        "kind",
        "overlay",
        "effective",
        "fingerprint"
      ]
    },
    "strategies": {
      "type": "object",
      "required": [
        "fingerprint",
        "profiles",
        "backends"
      ]
    },
    "experiment": {
      "type": "object",
      "required": [
        "reportType",
        "seed",
        "playerCount",
        "fingerprint"
      ]
    },
    "rng": {
      "type": "object",
      "required": [
        "algorithm",
        "version"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceCommit",
        "sourceDirty"
      ]
    },
    "launchIdentity": {
      "type": "object",
      "required": [
        "schemaVersion",
        "fingerprint"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "balanceContract": {
      "type": "object",
      "required": [
        "id",
        "status",
        "fingerprint"
      ]
    },
    "balanceEvaluation": {
      "type": "object",
      "required": [
        "contractId",
        "status",
        "checks",
        "promotionGate"
      ]
    },
    "configuration": {
      "type": "object",
      "properties": {
        "kitAssignments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "kit-red",
              "kit-blue",
              "kit-green",
              "kit-violet",
              "kit-gold"
            ]
          }
        }
      }
    }
  }
}
