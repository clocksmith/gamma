{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-2038.local/schemas/codex-controlled-session-preregistration-v1.schema.json",
  "title": "Mandate 2038 Codex Controlled Session Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "id",
    "locked",
    "seed",
    "runs",
    "playerCount",
    "release",
    "participants",
    "provider",
    "evidenceBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "codex-controlled-session-preregistration" },
    "id": { "type": "string", "minLength": 1 },
    "locked": { "const": true },
    "seed": { "type": "string", "minLength": 1 },
    "runs": { "const": 1 },
    "playerCount": { "const": 4 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "rulesVersion", "rulesetFingerprint", "releaseBoundaryCommit"],
      "properties": {
        "gameVersion": { "type": "string" },
        "rulesVersion": { "type": "string" },
        "rulesetFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "releaseBoundaryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seat", "factionId", "factionName", "profileId", "backend"],
        "properties": {
          "seat": { "type": "integer", "minimum": 0, "maximum": 3 },
          "factionId": { "type": "string" },
          "factionName": { "type": "string" },
          "profileId": { "type": "string" },
          "backend": { "const": "codex" }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoningEffort", "timeoutMs", "maxConcurrent", "maximumLlmDecisions"],
      "properties": {
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maximumLlmDecisions": { "type": "null" }
      }
    },
    "evidenceBoundary": { "type": "string", "minLength": 1 }
  }
}
