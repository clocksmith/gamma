{
  "schemaVersion": 1,
  "profiles": [
    {
      "id": "balanced_operator",
      "name": "The Balanced Operator",
      "description": "Builds a viable institution before committing to one victory path.",
      "defaultBackend": "weighted",
      "persona": {
        "identity": "A sober operator balancing research, infrastructure, adoption, and legitimacy.",
        "worldview": "A capability that cannot be powered, deployed, or defended publicly is not an advantage.",
        "riskPosture": "Accept measured ${terms.playerTracks.scrutiny} when it buys durable tempo.",
        "negotiationStyle": "Transactional, reciprocal, and willing to leave a deal.",
        "voice": "Concise, institutional, and practical."
      },
      "strategy": {
        "selection": "weighted",
        "negotiation": {
          "promiseWeight": 1.4,
          "fulfillWeight": 2.2,
          "betrayWeight": 0.7,
          "reciprocityWeight": 0.5
        },
        "resourceValues": { "runway": 1, "compute": 1.2, "safety": 1 },
        "objectives": [
          "Avoid compulsory action loops.",
          "Maintain enough ${terms.resources.compute} for ${terms.actions.research} and ${terms.actions.deploy}.",
          "Reach ${terms.systems.agi} eligibility without collapsing ${terms.playerTracks.trust}."
        ],
        "actionWeights": {
          "fund": 2.2,
          "research": 3,
          "build": 3,
          "organize": 0.8,
          "deploy": 3,
          "influence": 1.6,
          "mega_cluster": 2.5,
          "reorganization": 1.5,
          "open_weights": 4,
          "narrative_capture": 2,
          "agent_swarm": 4,
          "declare_agi": 24,
          "fusion_demonstrator": 3
        },
        "decisionWeights": {
          "fund_venture": 0.8,
          "build_generator_clean_infrastructure": 1.3
        },
        "consequenceWeights": {
          "poweredFacilities": 6,
          "powerDemand": 1
        },
        "rules": [
          {
            "when": [{ "path": "self.runway", "operator": "lte", "value": 2 }],
            "target": { "actionId": "fund" },
            "multiplier": 3
          },
          {
            "when": [{ "path": "self.unpoweredFacilities", "operator": "gt", "value": 0 }],
            "target": { "decisionIdPrefix": "build_generator_clean_infrastructure" },
            "multiplier": 4
          },
          {
            "when": [{ "path": "self.canDeploy", "operator": "eq", "value": true }],
            "target": { "actionId": "deploy" },
            "multiplier": 3
          }
        ]
      }
    },
    {
      "id": "capability_rusher",
      "name": "The ${terms.playerTracks.capability} Rusher",
      "description": "Pushes Training Runs and accepts volatile outcomes to reach thresholds first.",
      "defaultBackend": "weighted",
      "persona": {
        "identity": "A research leader convinced that capability creates its own institutional options.",
        "worldview": "${terms.resources.compute} and data are temporary constraints; an enduring capability lead is strategic.",
        "riskPosture": "Comfortable with failed runs and public controversy.",
        "negotiationStyle": "Trades resources readily but protects research tempo.",
        "voice": "Analytical, ambitious, and slightly impatient."
      },
      "strategy": {
        "selection": "weighted",
        "negotiation": {
          "promiseWeight": 1.1,
          "fulfillWeight": 1.4,
          "betrayWeight": 1.1,
          "reciprocityWeight": 0.25
        },
        "resourceValues": { "runway": 0.8, "compute": 1.8, "safety": 0.6 },
        "objectives": [
          "Maximize ${terms.playerTracks.capability} gained per ${terms.actions.research} action.",
          "${terms.actions.fund} ${terms.resources.compute} recovery when ${terms.actions.research} becomes impossible.",
          "${terms.actions.deploy} only when it converts an achieved threshold."
        ],
        "actionWeights": {
          "fund": 1.8,
          "research": 6,
          "build": 1.4,
          "organize": 0.5,
          "deploy": 2.4,
          "influence": 0.7,
          "mega_cluster": 1.5,
          "reorganization": 1,
          "open_weights": 6,
          "narrative_capture": 1.2,
          "agent_swarm": 5,
          "declare_agi": 28,
          "fusion_demonstrator": 2
        },
        "decisionWeights": {
          "research_stop_4": 2.5,
          "research_stop_5": 2
        },
        "consequenceWeights": {
          "poweredFacilities": 6,
          "powerDemand": 1
        },
        "rules": [
          {
            "when": [{ "path": "self.compute", "operator": "lte", "value": 1 }],
            "target": { "actionId": "fund" },
            "multiplier": 2
          },
          {
            "when": [{ "path": "self.canDeploy", "operator": "eq", "value": true }],
            "target": { "actionId": "deploy" },
            "multiplier": 2.5
          }
        ]
      }
    },
    {
      "id": "infrastructure_compounder",
      "name": "The Infrastructure Compounder",
      "description": "Builds a compact powered engine, then converts it into public thresholds and late ${terms.playerTracks.customers}.",
      "defaultBackend": "weighted",
      "persona": {
        "identity": "An infrastructure executive who sees every model as a load forecast.",
        "worldview": "Unpowered ambition is theater; durable capacity wins long contests.",
        "riskPosture": "Prefers capital risk to research risk.",
        "negotiationStyle": "Offers capacity from strength and dislikes dependency.",
        "voice": "Concrete, logistical, and systems-minded."
      },
      "strategy": {
        "selection": "weighted",
        "negotiation": {
          "promiseWeight": 1.25,
          "fulfillWeight": 2.5,
          "betrayWeight": 0.55,
          "reciprocityWeight": 0.6
        },
        "resourceValues": { "runway": 1.5, "compute": 1, "safety": 0.8 },
        "objectives": [
          "Establish two connected, powered Facilities without overbuilding.",
          "Use the engine to cross ${terms.playerTracks.capability} and ${terms.playerTracks.customer} ${terms.playerTracks.mandate} thresholds.",
          "Keep enough late tempo for Fusion, ${terms.technology.agentSwarm}, or an ${terms.systems.agi} claim."
        ],
        "actionWeights": {
          "fund": 2.4,
          "research": 3.2,
          "build": 3.8,
          "organize": 0.8,
          "deploy": 3,
          "influence": 0.9,
          "mega_cluster": 4,
          "reorganization": 1.3,
          "open_weights": 3.5,
          "narrative_capture": 1.5,
          "agent_swarm": 4,
          "declare_agi": 24,
          "fusion_demonstrator": 6
        },
        "decisionWeights": {
          "build_facility_cloud": 2.5,
          "build_facility_capital": 2,
          "build_generator_clean_infrastructure": 2
        },
        "consequenceWeights": {
          "poweredFacilities": 8,
          "powerDemand": 1
        },
        "rules": [
          {
            "when": [{ "path": "self.unpoweredFacilities", "operator": "gt", "value": 0 }],
            "target": { "decisionIdPrefix": "build_generator_clean_infrastructure" },
            "multiplier": 6
          },
          {
            "when": [{ "path": "self.facilities", "operator": "gte", "value": 2 }],
            "target": { "actionId": "deploy" },
            "multiplier": 3
          },
          {
            "when": [{ "path": "self.facilities", "operator": "gte", "value": 2 }],
            "target": { "actionId": "build" },
            "multiplier": 0.45
          },
          {
            "when": [{ "path": "self.canDeploy", "operator": "eq", "value": false }],
            "target": { "actionId": "research" },
            "multiplier": 1.8
          }
        ]
      }
    },
    {
      "id": "market_maximalist",
      "name": "The Market Maximalist",
      "description": "Treats ${terms.playerTracks.customers} and recurring ${terms.resources.runway} as the path to historical legitimacy.",
      "defaultBackend": "weighted",
      "persona": {
        "identity": "A product strategist who measures intelligence through adoption.",
        "worldview": "Markets settle arguments that benchmarks cannot.",
        "riskPosture": "Accepts deployment ${terms.playerTracks.scrutiny} but avoids research crashes.",
        "negotiationStyle": "Bundles access, distribution, and immediate concessions.",
        "voice": "Optimistic, commercial, and metric-driven."
      },
      "strategy": {
        "selection": "weighted",
        "negotiation": {
          "promiseWeight": 1.8,
          "fulfillWeight": 1.1,
          "betrayWeight": 1.7,
          "reciprocityWeight": 0.35
        },
        "resourceValues": { "runway": 1.4, "compute": 1.2, "safety": 0.7 },
        "objectives": [
          "${terms.actions.deploy} immediately at each ${terms.playerTracks.capability} threshold.",
          "${terms.actions.build} ${terms.playerTracks.customer} income.",
          "${terms.actions.research} conservatively enough to unlock the next market."
        ],
        "actionWeights": {
          "fund": 2,
          "research": 2.8,
          "build": 1.5,
          "organize": 0.6,
          "deploy": 7,
          "influence": 1,
          "mega_cluster": 1.2,
          "reorganization": 1.2,
          "open_weights": 3,
          "narrative_capture": 2,
          "agent_swarm": 4,
          "declare_agi": 26,
          "fusion_demonstrator": 1.5
        },
        "decisionWeights": {
          "research_stop_2": 2.5,
          "build_facility_consumer": 2
        },
        "consequenceWeights": {
          "poweredFacilities": 5,
          "powerDemand": 1
        },
        "rules": [
          {
            "when": [{ "path": "self.canDeploy", "operator": "eq", "value": true }],
            "target": { "actionId": "deploy" },
            "multiplier": 8
          },
          {
            "when": [{ "path": "self.canDeploy", "operator": "eq", "value": false }],
            "target": { "actionId": "research" },
            "multiplier": 2
          }
        ]
      }
    },
    {
