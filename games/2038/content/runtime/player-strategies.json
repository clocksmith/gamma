        "actionWeights": {
          "fund": 1.439,
          "research": 4.28,
          "build": 0.863,
          "organize": 0.444,
          "deploy": 2.594,
          "influence": 4.065,
          "mega_cluster": 4.205,
          "reorganization": 0.891,
          "open_weights": 2.026,
          "narrative_capture": 6.12,
          "agent_swarm": 6.198,
          "declare_agi": 11.702,
