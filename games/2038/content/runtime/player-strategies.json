{
  "schemaVersion": 1,
  "profiles": [
    {
      "id": "balanced_operator",
      "name": "The Balanced Operator",
      "description": "Builds a viable institution before committing to one victory path.",
      "defaultBackend": "weighted",
      "persona": {
        "identity": "A sober operator balancing research, infrastructure, adoption, and legitimacy.",
        "worldview": "A capability that cannot be powered, deployed, or defended publicly is not an advantage.",
        "riskPosture": "Accept measured ${terms.playerTracks.scrutiny} when it buys durable tempo.",
        "negotiationStyle": "Transactional, reciprocal, and willing to leave a deal.",
        "voice": "Concise, institutional, and practical."
      },
      "strategy": {
        "selection": "weighted",
        "negotiation": {
          "promiseWeight": 1.4,
          "fulfillWeight": 2.2,
          "betrayWeight": 0.7,
          "reciprocityWeight": 0.5
        },
        "resourceValues": {
          "runway": 1,
          "compute": 1.2
        },
        "objectives": [
          "Avoid compulsory action loops.",
          "Maintain enough ${terms.resources.compute} for ${terms.actions.research} and ${terms.actions.deploy}.",
          "Reach ${terms.systems.agi} eligibility without collapsing ${terms.playerTracks.trust}."
        ],
        "actionWeights": {
          "fund": 2.2,
          "research": 3,
          "build": 3,
          "organize": 0.8,
          "deploy": 3,
          "influence": 1.6
        },
        "decisionWeights": {
          "fund_venture": 0.8,
          "build_generator_clean_infrastructure": 1.3,
          "build_mega_cluster": 2.5,
          "build_fusion_demonstrator": 3
        },
        "consequenceWeights": {
          "poweredFacilities": 6,
          "powerDemand": 1
        },
        "rules": [
          {
            "when": [
              {
                "path": "self.runway",
                "operator": "lte",
                "value": 2
              }
            ],
            "target": {
              "actionId": "fund"
            },
            "multiplier": 3
          },
          {
            "when": [
              {
                "path": "self.unpoweredFacilities",
                "operator": "gt",
                "value": 0
              }
            ],
            "target": {
              "decisionIdPrefix": "build_generator_clean_infrastructure"
            },
            "multiplier": 4
          },
          {
            "when": [
              {
                "path": "self.canDeploy",
                "operator": "eq",
                "value": true
              }
            ],
            "target": {
              "actionId": "deploy"
            },
            "multiplier": 3
          }
        ]
      }
    },
    {
