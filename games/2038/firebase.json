{
  "hosting": {
    "public": "dist/firebase/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/mandate-2038",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/mandate-2038/:path*",
        "destination": "/:path*",
        "type": 301
      }
    ]
  }
}
