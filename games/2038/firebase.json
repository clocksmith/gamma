{
  "hosting": {
    "public": "dist/firebase/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/mandate-2038",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/mandate-2038/:path*",
        "destination": "/:path*",
        "type": 301
      },
      {
        "source": "/docs/map-reference.html",
        "destination": "/docs/core-rules.html#modular-hex-board",
        "type": 301
      },
      {
        "source": "/docs/component-reference.html",
        "destination": "/docs/core-rules.html#9-map-and-component-reference",
        "type": 301
      },
      {
        "source": "/docs/component-inventory.html",
        "destination": "/docs/core-rules.html#shared-governance-board",
        "type": 301
      },
      {
        "source": "/docs/card-reference.html",
        "destination": "/gallery-baseline.html",
        "type": 301
      }
    ]
  }
}
