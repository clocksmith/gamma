  },
  "factionTruthContract": {
    "status": "selected_design_constraint",
    "scale": {
      "minimum": 1,
      "maximum": 5,
      "meaning": "Relative institutional identity, not a point-buy budget or a promise of equal raw resources."
    },
    "dimensions": {
      "capitalAccess": "Ability to obtain and sustain Runway.",
      "computeAccess": "Privileged access to training and inference capacity.",
      "researchReliability": "Ability to turn Research attempts into dependable Capability.",
      "distribution": "Ability to reach Customers and markets.",
      "infrastructureVelocity": "Ability to build, move, and operate physical infrastructure.",
      "institutionalTrust": "Ability to accumulate legitimacy and withstand governance pressure.",
      "coalitionLeverage": "Ability to make mutually useful deals and shape other players' incentives."
    },
    "eligibilityRule": "Balance conversion, exposure, timing, rigidity, and dependency around faction truth. A candidate is ineligible if it removes the faction's protected strength, even when it improves parity.",
    "profiles": {
      "coalition_lab": {
        "ratings": {
          "capitalAccess": 4,
          "computeAccess": 2,
          "researchReliability": 2,
          "distribution": 3,
          "infrastructureVelocity": 2,
          "institutionalTrust": 3,
          "coalitionLeverage": 5
        },
        "protectedStrength": "Deals, coalitions, and institutional flexibility.",
        "balanceBottleneck": "Dependence on willing partners and terms that remain individually rational.",
        "forbiddenCorrection": "Do not make solo resource conversion more reliable than negotiated play."
      },
      "platform_empire": {
        "ratings": {
          "capitalAccess": 4,
          "computeAccess": 3,
          "researchReliability": 3,
          "distribution": 5,
          "infrastructureVelocity": 3,
          "institutionalTrust": 2,
          "coalitionLeverage": 2
        },
        "protectedStrength": "Installed Customers, distribution, and market reach.",
        "balanceBottleneck": "Trust, exposure, and escalating consequences from deployment.",
        "forbiddenCorrection": "Do not make the platform bad at reaching or monetizing Customers."
      },
      "imperial_research_lab": {
        "ratings": {
          "capitalAccess": 3,
          "computeAccess": 5,
          "researchReliability": 5,
          "distribution": 2,
          "infrastructureVelocity": 3,
          "institutionalTrust": 4,
          "coalitionLeverage": 2
        },
        "protectedStrength": "Compute access, Research reliability, and Capability generation.",
        "balanceBottleneck": "Public validation, commercialization, and claim timing.",
        "forbiddenCorrection": "Do not make successful scientific rigor reduce Capability or make the institution compute-poor."
      },
      "vertical_empire": {
        "ratings": {
          "capitalAccess": 5,
          "computeAccess": 4,
          "researchReliability": 2,
          "distribution": 3,
          "infrastructureVelocity": 5,
          "institutionalTrust": 1,
          "coalitionLeverage": 2
        },
        "protectedStrength": "Infrastructure velocity, capital, and physical mobility.",
        "balanceBottleneck": "Scrutiny, strategic rigidity, and political legitimacy.",
        "forbiddenCorrection": "Do not make the institution slow at constructing or relocating infrastructure."
      },
      "safety_laboratory": {
        "ratings": {
          "capitalAccess": 2,
          "computeAccess": 2,
          "researchReliability": 4,
          "distribution": 2,
          "infrastructureVelocity": 1,
          "institutionalTrust": 5,
          "coalitionLeverage": 4
        },
        "protectedStrength": "Safeguards, Trust, and controlled deployment.",
        "balanceBottleneck": "Slower expansion and fewer aggressive conversions.",
        "forbiddenCorrection": "Do not make caution, safeguards, or Trust a losing position in itself."
      },
      "foundry": {
        "ratings": {
          "capitalAccess": 4,
          "computeAccess": 5,
          "researchReliability": 2,
          "distribution": 2,
          "infrastructureVelocity": 4,
          "institutionalTrust": 3,
          "coalitionLeverage": 4
